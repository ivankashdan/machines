}



else if (gInventoryBar.Visible==false)
{
  
  
  
     if ( Object.GetAtScreenXY(mouse.x, mouse.y))
{
   Mouse.ChangeModeGraphic(eModeWalkto, 1805);
   lblAction.Text="";
}
     else if ( Character.GetAtScreenXY(mouse.x, mouse.y))
{
   Mouse.ChangeModeGraphic(eModeWalkto, 1805);
   lblAction.Text="";
}
 else {
   
    if (Hotspot.GetAtScreenXY(mouse.x, mouse.y)== hObjects) {
  
  
  if (Tfound==1) {
    Mouse.ChangeModeGraphic(eModeWalkto, 1808);
    //Mouse.ChangeModeView(eModeWalkto, 226);
    
  }
  
  else if (Pspoken==0) {
    Mouse.ChangeModeGraphic(eModeWalkto, 1805);
    
    
  }
  
  else {
    Mouse.ChangeModeGraphic(eModeWalkto, 1806);
    //Mouse.ChangeModeView(eModeWalkto, 229);
    
  }
  
  
  
}

 else if  ( Hotspot.GetAtScreenXY(mouse.x, mouse.y)== hHotspot1 )




{
  Mouse.ChangeModeGraphic(eModeWalkto, 1804);
  //Mouse.ChangeModeView(eModeWalkto, 228);
}


 else if  (( Hotspot.GetAtScreenXY(mouse.x, mouse.y)== hHotspot11 )
 || ( Hotspot.GetAtScreenXY(mouse.x, mouse.y)== hShrine )
