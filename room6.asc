function room_RepExec()
{
  
  
    if ((Tfound==0)&&(TwiggyFallen==0)) {
  TwiggyWait+=1;
  
  if (TwiggyWait==250) {
    rTwiggyFalls.Transparency=0;
    rTwiggyFalls.LockView(101, eKeepMoving);
    rTwiggyFalls.Animate(0, 5, eOnce, eBlock);
    rTwiggyFalls.UnlockView();
    rTwiggyFalls.Transparency=100;
    rT.ChangeRoom(6);
    //rT.Transparency=0;
    TwiggyFallen=1;
    hShoot.Enabled=true;
    
    
  }
  }

  
  
  if ((Game.IsAudioPlaying(eAudioTypeAmbientSound)==false)&&(PicnicLost==0)) {
    
    aWind_sheltered_ambient_21.Play();
    
  }
  
  
  
      if (IdleTimer>100) {
    
    IdleHeld=0;
    IdleTimer=0;
  }
  
  
    if (IdleHeld==1) {
    IdleTimer++;
      
    }

  
  

   else if ((StageCounter==0)&&(Tfound==0)){
    PRambling+=1;
    
 

if (PRambling==500) {
   cLastWords.SayBackground ("Change is inevitable...");
   Pspoken=1;
 // cLastWords.SayBackground("We will be reborn...");
 //cLastWords.SayBackground("Spring is coming...");
 
 //cLastWords.SayBackground("Winter will be over soon...");
//cLastWords.SayBackground("Here and there a new shoot grows...");
 }


if (PRambling==900) {
  cLastWords.SayBackground ("The earth will accept us...");
  // cLastWords.SayBackground ("I can feel it");
  //cLastWords.SayBackground ("Spring is lost past due...");
//cLastWords.SayBackground("Here and there a new shoot grows...");
 }


  if (PRambling==1400) {
    cLastWords.SayBackground ("We will not be abandoned...");
   // cLastWords.SayBackground ("Even we can transform... into something new");
   
//cLastWords.SayBackground ("It will be slow... ");
  }
  
  
if (PRambling==1800) {
  cLastWords.SayBackground ("Our bones are strong but they will grow brittle...");
 
//cLastWords.SayBackground ("But while there is still movement, change is inevitable...");
}
if (PRambling==2300) {
  
  cLastWords.SayBackground ("The hull will melt into rust-coloured leaves...");
//cLastWords.SayBackground ("Even we can transform... into something new");
}


if (PRambling==3000) {
  //cLastWords.SayBackground ("We will return to the cycle of birth and rebirth...");
//cLastWords.SayBackground ("The earth will accept us, again...");
}

if (PRambling==3500) {
//cLastWords.SayBackground ("We will return to the cycle of birth and rebirth...");



}

if (PRambling==4000) {
//cLastWords.SayBackground ("Our bones are strong but they will grow brittle...");


}

if (PRambling==4500) {
//cLastWords.SayBackground ("The hull will melt into rust-coloured leaves...");


}

   }
  
  
  
  

}


function room_Leave()
{
  
  

  
SaveGameSlot(1, "Autosave");
  
    lblAction.TextColor=0;
  lblAction.Font=eFontFont3;
  


  
  if (cHoopL.Room==6) {
  cHoopL.ChangeRoom(11);
  Crimescene=1;
}

if ((World1==0)&&(WorldBottleFull==0)) {
  
  
  
if (TicCollected==0) {
  
  PRfound=1;
  cMap.AddInventory(iPR);
  Displaytext();
  
  TicCollected=1;
  //FoundCounter++;
  PRmessage=1;
  
}
}

  


}
  

