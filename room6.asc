function room_Load()
{
  
   IdleHeld=0;
  



if ((TwiggyFallen==1)&&(Tfound==0)) {
  rT.ChangeRoom(6);
  
  hShoot.Enabled=true;
  
}

else {
  
  hShoot.Enabled=false;

}

  
     Place.SetView(267);
  Place.Animate(0, 5, eRepeat, eNoBlock, eForwards);
  
 // HBfound=1;
//  cMap.AddInventory(iHeliobrother);
//  ORfound=1;
 // cMap.AddInventory(iOR);
//  Dfound=1;
  // cMap.AddInventory(iDiamond);
 // Sfound=1;
  // cMap.AddInventory(iSpiraly);     //temporaries ^
  
  //rTliving.Transparency=30;
  //rTliving.Tint(0, 0, 0, 30, 80);
  


      if (WorldTreeDead==0) {
  aWind_sheltered_ambient_21.Play();
}
  else {
  aBirdsilence_ambient.Play();
  SetBackgroundFrame(1);
}

  
  
  TicCollected=1;       ///temporarily stop PR from being picked up here
  
   Place.Visible=false;
  hPlace.Enabled=false;
  
  lblAction.TextColor=65535;
lblAction.Font=eFontFont4;




  Refresh();
     
    hPlace.Enabled=false;
  
 

  cCrimescene.Transparency=100;
 // rTwiggyFalls.Transparency=100;
  cPicnicStill.Transparency=100;
  //cPicnicStill.Transparency=80;
  rTpatch.Transparency=100;
 
    
    
    
    


  

}



