// room script file


int MusicPlaying=0;


function room_FirstLoad()
{




}




function room_Load()
{
  

  Refresh();
     
    PlaceActive=1;
  
 
  
cBlack.ChangeRoom(20);

  

}



function room_AfterFadeIn()
{ 

cBlack.ChangeRoom(11);
  FadeIn(50);
  
 
}




function repeatedly_execute_always()
{
 
  

   
  
  
  

    // ALL ACTION TEXT INVISIBLE 
   
 
    if (Game.GetLocationName(mouse.x,  mouse.y) != null) {
    lblAction.Text="";
   }
   
   
   if (Game.IsAudioPlaying(eAudioTypeMusic)==true)
   {
     Game.SetAudioTypeVolume(eAudioTypeAmbientSound, 20, eVolChangeExisting);
     
   }
   else { Game.SetAudioTypeVolume(eAudioTypeAmbientSound, 30, eVolChangeExisting); }
   
   
   
   
   
}
  
  



