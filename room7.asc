function hHotspot13_Interact()
{
  
  if (Peel==0) {
    Wait(10);
cPeel.Say("ho mei ^3^");
Peel=1;
  }
  else if (Peel==1) {
    Wait(20);
    cPeel.Say("ho ho mei");
    Peel=2;
  }
    else if (Peel==2) {
      Wait(30);
    cPeel.Say("ho ho ho mei");
    Peel=3;
  }
    else if (Peel==3) {
      Wait(40);
    cPeel.Say("ho ho ho ho mei");
    Peel=4;
  }
   

}
