function room_RepExec()
{

 
   
        if (IdleTimer>100) {
    
    IdleHeld=0;
    IdleTimer=0;
  }
  
  
    if (IdleHeld==1) {
    IdleTimer++;
      
    }

    
    else if ((cHoopL.Room==7)&&(StageCounter>1)&&(gInventoryBar.Visible==false))  {
      
      Roadstacking+=1;
      
      
       if (Roadstacking==100) {
cHoopL.SayBackground("Oh no! This isn't going to end well");
       }
       if (Roadstacking==400) {
   cHoopL.SayBackground("Why are you playing in the middle of the road?");
       }
      
      
      
      
        if (Roadstacking==700) {
  cHoopL.SayBackground("Don't you know that's dangerous?");
  }
  
  
     if (Roadstacking==1100) {
  cHoopL.SayBackground("You're making me nervous...");
  }
  
  
    if (Roadstacking==1400) {
cHoopL.SayBackground ("At least come over to the pavement!");
}

      
      
      
      if (Roadstacking==1700) {
        lblAction.Text="";
      cHoopL.Say ("Okay, stranger. [You're freaking me out a bit now");
      Wait(50);
          //aChime_strikeEND.Play();
      //cHoopL.Say ("Catch you later");
      cHoopL.Say ("Uh... bye!");
        catchyoulater=1;
      Wait(10);
      aPR_land.Play();
      cHoopL.ChangeRoom(11);
    

    
//Wait(50);
Label5.Text="CONNECTION LOST";
gGui3.Visible=true;
//aWhirligig3.Play();
Mouse.Visible=false;
Wait(150);
gGui3.Visible=false;
Label5.Text="NEW OBJECTIVE ACQUIRED";
Mouse.Visible=true;
      
    
      
    }
       }
    
    
    
   else if ((cHoopL.Room==7)&&(StageCounter==0)) {
     
IdleCounter+=1;


 if (IdleCounter==500) {
cHoopL.SayBackground("Where on earth...");
 }
 if (IdleCounter==800) {
   cHoopL.SayBackground("Where could it have gone?");
   
//cRoger.SayBackground("What a rush!");
//cHoopL.SayBackground ("And you're sure you didn't see anything?");

 }
 
 
 
  if (IdleCounter==1500) {
  cHoopL.SayBackground("Could have sworn I left it right here...");
  }
  
  
    if (IdleCounter==2200) {
cHoopL.SayBackground ("Well... I guess I'll keep looking");
}
  

 
if (IdleCounter==1000) {
  
  
  //IdleCounter=0;
}
   }


      






}


