  if (onedrinktomany==0) {
  GEndCounter=0;
  }
  else if (onedrinktomany==1) {
     GEndCounter=1;
  }
  
  
  
if (Licker==1) {
  
 Licker=2; 
}

if (Spilt==1) {
Spilt=0;
}


  
  
  
  
aPortal_bowl.Stop();

if (Game.IsAudioPlaying(eAudioTypeMusic)) {
  Game.StopAudio(eAudioTypeMusic);
}


PlaceActive=0;

Refresh();

  }
 
 
 Place.Visible=false;
  hPlace.Enabled=false;
  
hKerb.Enabled=false;





  Refresh();
     
  
 lblAction.Visible=true;
  

if (Sfound==0) {
  rSpiraly.ChangeRoom(7);
rSpiraly.Baseline=1;
rSpiraly.SetIdleView(59, 0);
  
}

if (Sfound==1) {
rSpiraly.ChangeRoom(11);
  
}



  if (PathwayBuild==1) {
  
  if (World1==1) {
  
  if (W1Sfound==0) { //World 1
  
rSpiraly.ChangeRoom(7);
rSpiraly.Baseline=1;
rSpiraly.SetIdleView(59, 0);
} 
}

 if (World2==1) {
    cHoopL.ChangeRoom(7);
    cHoopL.Clickable=false;
    
    if (cMap.HasInventory(iSpiraly)==true) {
      cHoopL.ChangeRoom(11);
    }
    
  }
  if (WorldBottleFull==1) {
rSpiraly.ChangeRoom(11);
lblAction.Visible=true;
  hHotspot3.Enabled=true;
  hHotspot2.Enabled=true;

}

  
  
  if (Dfound==0) {
  
      rD.ChangeRoom(7);
  
}
if ((Dfound==1)&&(HoopHere==0)) {
   cHoopL.ChangeRoom(7);
