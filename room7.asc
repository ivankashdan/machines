    horrified=0;
    
    
  }
  
  
  if (cMap.PreviousRoom==23) {
    
    Mouse.Visible=true;
  }
  
 GlobalTimerStart=1;
  
  
      Place.SetView(268);
  Place.Animate(0, 5, eRepeat, eNoBlock, eForwards);
  
  
 
 
