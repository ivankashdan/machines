function repeatedly_execute_always()
{
  
  
  if (Sfound==1) {
    
  
    
   aObject_present_cowbell.Stop();
    
    
    
  }
  
  
  
  
if (cMap.ActiveInventory!=null) {  //MAKE OBJECTS GLOW BLUE BEFORE COMBINING
    if ((Character.GetAtScreenXY(mouse.x, mouse.y)== ofPN) ||        //if item held and hovering over fallen item
    (Character.GetAtScreenXY(mouse.x, mouse.y)==  ofS) ||
    (Character.GetAtScreenXY(mouse.x, mouse.y)== ofT) ||
    (Character.GetAtScreenXY(mouse.x, mouse.y)== ofOR) ||
    (Character.GetAtScreenXY(mouse.x, mouse.y)== ofPR) ||
    (Character.GetAtScreenXY(mouse.x, mouse.y)== ofZ) ||
    (Character.GetAtScreenXY(mouse.x, mouse.y)== ofPP) ||
    (Character.GetAtScreenXY(mouse.x, mouse.y)== ofPP_S) ||
    (Character.GetAtScreenXY(mouse.x, mouse.y)== ofLG) ||
    (Character.GetAtScreenXY(mouse.x, mouse.y)== ofD) ||
    
    (Character.GetAtScreenXY(mouse.x, mouse.y)== ofHB) ||
    
        (Character.GetAtScreenXY(mouse.x, mouse.y)== ofS_OR) ||
    (Character.GetAtScreenXY(mouse.x, mouse.y)== ofS_OR_PN) 

    )
    {
             
      SetAmbientTint(0, 0, 0, 0, 0); 
      
    }
    
    else if (Character.GetAtScreenXY(mouse.x, mouse.y))        //if item held over character
    {
      
      SetAmbientTint(66, 135, 245,  20, 50);
      
    }
      
    else if (Object.GetAtScreenXY(mouse.x, mouse.y))         //if item held over object (doubled up)
     {
       
      SetAmbientTint(66, 135, 245, 20, 50);
    }
     else {                                                   //if item held over anything else
       
       SetAmbientTint(0, 0, 0, 0, 0);   
     }
    }
      
     
      else{                                             //normal if nothing is held
      
      SetAmbientTint(0, 0, 0, 0, 0);                         
      
      
    }


if (cHoopL.Speaking==true) {
    lblAction.Text="";
  }
    
    
    
    



