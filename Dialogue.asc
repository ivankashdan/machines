//Text functions (Shrine)

function oHBtext() //Guard
{
    cLady.Say("Poor thing. I see you are tired of wandering");
    cLady.Say("But what is this?");
    cLady.Say("Blood on the rust. I must be mistaken.");
    cLady.Say("The Brothers had their fangs removed. It must be an accident.");
    //cLady.Say("This one is almost as rusty as I am.");
    //cLady.Say("Funny. I seem to remember them being silver.");
    //cLady.Say("More importantly. I see you have awoken at last.");
    //cLady.Say("Welcome back little one. And welcome to the world at last.");
}

function oHB_Ttext() //Mallet
{
    cLady.SayBackground("A beater. Made not for violence but to strike a steady rhythm");
    //cLady.Say("But to strike a steady rhythm. As like the turning of the sun through the trees...");
}

function oDtext() //Diamond
{ 
  cLady.Say("Pretty thing...");
  cLady.Say("I have not seen one such as you, since the courts of the old lord's kingdom.");
  cLady.Say("Now you are alone, like the rest of us. But perhaps for the first time");
  cLady.Say("Free from those would desire, use and abuse your inheritence.");
  //cLady.Say("I believe seers were able to work certain magics with such devices. [If only I had paid more attention...");
  //cLady.Say("Disaster might have been averted...");
  //cLady.Say("Once you would have been worth something.");
}

