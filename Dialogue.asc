 if (Descended==0) {
   
   if (wellline==0) {
   
   Game.StopAudio(eAudioTypeMusic);
   Wait(50);
   cLady.Say("The dark is contained.");
   Wait(50);
      cLady.Say("Held close, where it can't escape");
   cLady.Say("It is no longer a vast, endless night");
   cLady.Say("But our very own...");
    Wait(50);
   cLady.Say("It's very small now and fits snugly in the palm of your hand.");
    Wait(50);
    Wait(50);
   cLady.Say("Remember this children, when next you are in a dark place. Lost and confused");
   cLady.Say("How the shadows can be commanded");
   


  wellline=1;
 }
 
 else if (wellline==1) {
   Wait(30);
   
   cLady.Say("How much darkness can you hold, children?");
   cLady.Say("In the palm of your hand?");

wellline=2;

}
 }
}
  
