function Scarecrowtext() //oOR_PPS_T_Ztext
{
    cLady.Say("How could one forget");
    cLady.Say("Once a giant in the woods, half a tree himself");
    cLady.Say("With a voice to carry the centuries. But alas, no bite");
    cLady.Say("Little more than a scarecrow, when the visitors arrived:");
    cLady.Say("A miasma determined to eradicate all memory of the living");
    cLady.Say("Reduced his forest to dust...");
    Wait(30);
    cLady.Say("His screams carry into town, without trees to blot out the sound");
    cLady.Say("And after centuries, I'm afraid we have grown used to the endless wailing.");
    cLady.Say("His grief has become little more than background noise... a terrible tragedy");
    cLady.Say("Continues to fall on deaf ears.");
    Wait(30);
    cLady.Say("Strange... Now that I focus, I find I can no longer hear him");
    cLady.Say("Perhaps the woods around me have grown thicker than I imagined.");
}


