function oOR_Ttext() //Diviniation Stick
{
  //aMagnolia_loop2.Play();
  //aDay1_lady_loop1.Play();
  
  
  
  
  if (RestartReminder2==0) {
    
         lblAction.Text="";
         Wait(50);
     cLady.Say("Oh.");
     
    // aLady_awakes.Play();
     aMHLD_lady_awakes2.Play();
     //aMagnolia_loop1.Play();
     
     Wait(50);
   
     cLady.Say("It's my old divination stick.");
     cLady.Say("How did you know?");
     
  }
  
  else {
 Wait(50);
  cLady.Say("Looks like my old divination stick");
  }
  
   Wait(50);
   Fortune=1;
  Wait(200);
   Fortune=0;
   Wait(50);
  cLady.Say("I see... while the old pathways have been lost");
  cLady.Say("The miasma of the ages, the old growth, still finds its way back to us lost souls...");
  Wait(50);
   Wait(50);
  cLady.Say("I thank you, eternal children");
  cLady.Say("For you have guessed the form of my sacred relic");
  cLady.Say("This is how you found me and how you will find the others");
    RestartReminder2=1;
     LFirstmeeting=1;
     LEndCounter=0;

  Guessed=1;

  aMagnolia_key_loop.Stop();

}

