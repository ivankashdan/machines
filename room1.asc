function room_FirstLoad()
{
 //whirlitask=1;             //temporary to get through opening dialogue
  //Wintro=1; //Temporary 
  
  
  
}



function room_Load()
{
  
  
   IdleHeld=0;
  
  
  Place.SetView(239);
  Place.Animate(0, 5, eRepeat, eNoBlock, eForwards);

  
  
  if (cMap.PreviousRoom==2) {
    
    SetAmbientLightLevel(0);


  }
  
  Mouse.Visible=false;




  
  Refresh();
  
    
  cBlack.ChangeRoom(1);
  cBlack.Baseline=10;
  cBlack.Transparency=0;
  
 

     hPlace.Enabled=false;
     Place.Visible=false;
 
 
  
  
  if (WorldTreeDead==1) {
    
    PlaceActive=1;
    cRoger.ChangeRoom(1);
    cRoger.SetIdleView(16, 0);
    
    cMoor.ChangeRoom(1);
    cMoorMist.ChangeRoom(1);
    cMoorMist.SetIdleView(115, 0);
  
   
       cMoor.Baseline=1;
   cRoger.Baseline=2;
   cRogerEmpty.Baseline=2;
   cMoorMist.Baseline=3;
 
   ENDCounter=1;
   StageCounter=0;
   hPorcupinePickup.Enabled=false;
   hHotspot4.Enabled=false;
   aWhirligig_ambient.Play();

    
    
  }
  else {
    
     PlaceActive=1;
     cRoger.ChangeRoom(1);
    cRoger.SetIdleView(3, 0);
    
    cMoor.ChangeRoom(1);
    cMoorMist.ChangeRoom(1);
    cMoorMist.SetIdleView(115, 0);
    cMoor.Baseline=1;
    cRoger.Baseline=2;
   
   cRogerEmpty.Baseline=2;
   cMoorMist.Baseline=3;

   ENDCounter=1;
   StageCounter=0;
   hPorcupinePickup.Enabled=false;
   hHotspot4.Enabled=false;
      
    aWhirligig_heavy_ambient.Play();
  
  }
  
  

  if (cMap.PreviousRoom==2) {
    
   
    //aCollapse1.Play();
    aORfalls.Play();
    aTfalls.Play();
   ofOR.ChangeRoom(1);
   ofT.ChangeRoom(1);

   cMap.LoseInventory(iOR);

   cMap.LoseInventory(iT);
   Collapsed=1;
    CollapsedRoom=1;
    
  }





}



function room_AfterFadeIn()
{
  
  
  
 
  
  
  
  
  if (Wintro==0) {
  
  Label6.Visible=false;
  Wait(50);
  FadeIn(3);
  
  gGui2.Visible=true;
Mouse.Visible=false;
Label4.Text="An old forest once grew on this hill. [[The rain might still come, but since it was cleared, nothing has grown in this region. [[Instead, wind lashes the tightly woven grass and those unfortunate enough to cross the downs.";
Wintro=1;

  }
  
    else if (Wintro==1) {
     Mouse.Visible=true;
  }
  
  cBlack.ChangeRoom(11);
    if (gGui2.Visible==true) {
FadeIn(3);  
  }

 
 
 
 
    //PNfound=1;   //temporary
  
  if (PNfound==1&&finduncle==0) {  

    Wait(50);
      
    
     aMagic_chimes.Play();
  finduncle=1;
  ObjectivesList.InsertItemAt(0,"Find Uncle");
  addobjectivetimer=1;

    
  }
 
}


function repeatedly_execute_always()
{
  
  
if (oOR_T_GLOW.Room==1) {
  
  
  hGLOW.Enabled=true;
  cRoger.Clickable=false;
  
}
else {
  
  hGLOW.Enabled=false;
   cRoger.Clickable=true;
  
  
}



    lblAction.TextColor=65535;
lblAction.Font=eFontFont4;

 
 
 
 TimerW++;
 
 
  if ((gGui2.Visible==true)&&(TimerW>300)) {
 
 Label6.Visible=true;
 }
 
 

   
    if (cMap.ActiveInventory!=null) {  //MAKE OBJECTS GLOW BLUE BEFORE COMBINING
    if ((Character.GetAtScreenXY(mouse.x, mouse.y)== ofPN) ||        //if item held and hovering over fallen item
    (Character.GetAtScreenXY(mouse.x, mouse.y)==  ofS) ||
    (Character.GetAtScreenXY(mouse.x, mouse.y)== ofT) ||
    (Character.GetAtScreenXY(mouse.x, mouse.y)== ofOR) ||
    (Character.GetAtScreenXY(mouse.x, mouse.y)== ofPR) ||
    (Character.GetAtScreenXY(mouse.x, mouse.y)== ofZ) ||
    (Character.GetAtScreenXY(mouse.x, mouse.y)== ofPP) ||
    (Character.GetAtScreenXY(mouse.x, mouse.y)== ofPP_S) ||
    (Character.GetAtScreenXY(mouse.x, mouse.y)== ofLG) ||
    (Character.GetAtScreenXY(mouse.x, mouse.y)== ofD) ||
    (Character.GetAtScreenXY(mouse.x, mouse.y)== ofHB) ||
    (Character.GetAtScreenXY(mouse.x, mouse.y)== ofS_OR) ||
    (Character.GetAtScreenXY(mouse.x, mouse.y)== ofS_OR_PN) ||
    
    (Character.GetAtScreenXY(mouse.x, mouse.y)== cRoger) ||          //input other items in room here
    (Hotspot.GetAtScreenXY(mouse.x, mouse.y)== hCity))
    
    {
             
      SetAmbientTint(0, 0, 0, 0, 0); 
      
    }
    
    
    
    
    else if (Character.GetAtScreenXY(mouse.x, mouse.y))        //if item held over character
    {
      
      SetAmbientTint(66, 135, 245,  20, 50);
      
    }
      
    else if (Object.GetAtScreenXY(mouse.x, mouse.y))         //if item held over object (doubled up)
     {
       
      SetAmbientTint(66, 135, 245, 20, 50);
    }
     else {                                                   //if item held over anything else
       
       SetAmbientTint(0, 0, 0, 0, 0);   
     }
    }
      
     
      else{                                             //normal if nothing is held
      
      SetAmbientTint(0, 0, 0, 0, 0);                         
      
      
    }
 
     
     
     
    
     
     
 

 
 
 
   if (Character.GetAtScreenXY(mouse.x, mouse.y)== cRoger) {

  
  if (WorldTreeDead==0) {
    
    Mouse.ChangeModeGraphic(eModeWalkto, 1806);
 
  }
  else {
    Mouse.ChangeModeGraphic(eModeWalkto, 1808);

    lblAction.Text="A skeletal armature is all that remains";
  }
}

else if (Button.GetAtScreenXY(mouse.x, mouse.y) == btnInvDown) {
  
 
  lblAction.Text="Take all";
}



 else if  (( Hotspot.GetAtScreenXY(mouse.x, mouse.y)== hCity )&&(gInventoryBar.Visible==false)) { 

Mouse.ChangeModeGraphic(eModeWalkto, 1804);
  
}

else if (( Hotspot.GetAtScreenXY(mouse.x, mouse.y)== hGLOW) || 
( Character.GetAtScreenXY(mouse.x, mouse.y)== oOR_T_GLOW)) 

{
  Mouse.ChangeModeGraphic(eModeWalkto, 2086);
 
}


else if ( Hotspot.GetAtScreenXY(mouse.x, mouse.y)== hPlace )
{
  
}
 
 else if (gInventoryBar.Visible==false)
{
  
  lblAction.Text="";
  
    if ( Object.GetAtScreenXY(mouse.x, mouse.y))
    {
       Mouse.ChangeModeGraphic(eModeWalkto, 1805);
    }
    else if ( Character.GetAtScreenXY(mouse.x, mouse.y))
    {
       Mouse.ChangeModeGraphic(eModeWalkto, 1805);
    }
    
     else 
     {
  
 Mouse.ChangeModeGraphic(eModeWalkto, 2061);
 }

}
 
  
                     //layers control on MOOR
   
   cMoor.Baseline=1;
   cRoger.Baseline=2;
   cRogerEmpty.Baseline=2;
   cMoorMist.Baseline=3;
   Place.Baseline=5;
   cBlack.Baseline=10;
   
   
}
  
  

function room_RepExec()
{
  

   

    if (Character.GetAtScreenXY(mouse.x, mouse.y)== cRoger) {

  
  if (WorldTreeDead==0) {
   lblAction.Text="Clothes blow back and forth on the armature";
  }
   }
   
   
   if ((WorldTreeDead==0)&&(gGui2.Visible==false)) {
   
     
    if (Game.IsAudioPlaying(eAudioTypeAmbientSound)==false) {
    aWhirligig_ambient.Play();
  }
  
  
  
   if (whirlitask==0) {

 WindCounter+=1;


 if (WindCounter==50) {
if ((StageCounter>=1)&&(object[14].Visible==false)&&(oPR_T.Room!=1)) {
  aWhirligig4.Play();
StageCounter=0;
CollapseCounter=1;
}
 }
 
  if (WindCounter==90) {
if ((StageCounter>=1)&&(object[14].Visible==false)&&(oPR_T.Room!=1)) {
  aWhirligig4.Play();
StageCounter=0;
CollapseCounter=1;
}

  }
  if (WindCounter==140) {
if ((StageCounter>=1)&&(object[14].Visible==false)&&(oPR_T.Room!=1)) {
  aWhirligig4.Play();
StageCounter=0;
CollapseCounter=1;
}
  }
  
if (WindCounter==180) {
if ((StageCounter>=1)&&(object[14].Visible==false)&&(oPR_T.Room!=1)) {
  aWhirligig4.Play();
StageCounter=0;
CollapseCounter=1;
}
}
if (WindCounter==250) {
if ((StageCounter>=1)&&(object[14].Visible==false)&&(oPR_T.Room!=1)) {
  aWhirligig4.Play();
StageCounter=0;
CollapseCounter=1;
}
}
if (WindCounter==300) {
if ((StageCounter>=1)&&(object[14].Visible==false)&&(oPR_T.Room!=1)) {
  aWhirligig4.Play();
StageCounter=0;
CollapseCounter=1;

}
}

if (WindCounter==310) {
  
  
  WindCounter=0;
}

}

  
      if (IdleTimer>100) {
    
    IdleHeld=0;
    IdleTimer=0;
  }
  
  
    if (IdleHeld==1) {
    IdleTimer++;
      
    }

  
  else if (hic==1) {
    
    hiccounter++;
    
    if (hiccounter==20) {
    cRoger.SayBackground("HIC!");  
    }
    
    if (hiccounter==100) {
    cRoger.SayBackground("HIC!");  
    }
    
    if (hiccounter==200) {
    cRoger.SayBackground("HIC!");  
    }
    
    if (hiccounter==240) {
    cRoger.SayBackground("HIC!");  
    }
    
    if (hiccounter==500) {
    cRoger.SayBackground("HIC HIC!");  
    }
    
    if (hiccounter==800) {
    cRoger.SayBackground("Blast!");  
    }
    
    if (hiccounter==840) {
    cRoger.SayBackground("HIC!"); 
    }
    
    if (hiccounter==1200) {
    hiccounter=0;  
    }
    
  }
  
  

  else if ((treeplanted==1)&&(oOR_T_GLOW.Room==1))
   {
     
       glowcounter+=1;
       
  if (glowcounter==200) {
cRoger.SayBackground("Trees don't normally glow like this...");

 }
 
       if (glowcounter==450) {
    
     treeplanted=2;
        }
   }
  
  


else if ((keepembusy==1)&&(WhirliCounter==11)&&(treeplanted==0)&&(fHBCounter==0)&&(StageCounter==0)) {
  
   IdleCounter+=1;
  
  if (IdleCounter==150) {
cRoger.SayBackground("I'll keep watch. I'm sorry I can't be of more help");
 }
 

 
 
  if (IdleCounter==450) {
    cRoger.SayBackground("Hmm... perhaps some calming birdsong?");
  

}


  
  if (IdleCounter==800) {
    cRoger.SayBackground("I can perfectly imitate the sounds of spring...");

  }
  
  
    if (IdleCounter==950) {
    cRoger.SayBackground("Listen closely");
  

}

 
 
 if (IdleCounter==1100) {
  
cRoger.SayBackground ("OOH-WAH OOH-WAH");

}

if (IdleCounter==1500) {
cRoger.SayBackground ("REEEE-REEE-RREE-CO-LA");

}
if (IdleCounter==1900) {
  
  
  cRoger.SayBackground ("Hmm... no, I think I have the wrong pronunciation");

}

if (IdleCounter==2300) {
  
  cRoger.SayBackground ("TWEET TWEET TWEET");

}

if (IdleCounter==2600) {
  
  cRoger.SayBackground ("TU-WOO TU-WOO TU-WOO TU-WOO");


}

if (IdleCounter==3000) {
  
  cRoger.SayBackground ("I can imitate the wind in the trees too...");

}


if (IdleCounter==3300) {
  
  cRoger.SayBackground ("PSSSSSSSSSSHH");

}

if (IdleCounter==3600) {

cRoger.SayBackground ("PWWWSSSSSHHHHHH");

}


if (IdleCounter==4000) {

cRoger.SayBackground ("Hmm... perhaps some more calming birdsong?");
IdleCounter=500;
}


 
}


 }
 
}



function room_Leave()
{
  
  lblAction.TextColor=0;
  lblAction.Font=eFontFont3;



if ((treeplanted!=0)&&(cMap.PreviousRoom==22)) {       ///temporary code to stop comment on planters being fragile happening for something that isn't planter
  easymistake=1;
}


SaveGameSlot(1, "Autosave");


}



function hCity_Interact()
{
cMap.ChangeRoom(22);
}



function hGLOW_Interact()
{

  Mouse.Visible=false;
  
  
aPoof.Play();
  
  
  Wait(20);
  silence=1;
  Game.StopAudio(eAudioTypeAmbientSound);
  Game.StopAudio(eAudioTypeMusic);
  aPortal_bowl.Stop();
  
  
 
  cMap.ChangeRoom(2);



FadeOut(50);
Wait(100);
silence=0;


}
