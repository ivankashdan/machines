function room_Leave()
{
  
if (Game.IsAudioPlaying(eAudioTypeMusic)) {
  Game.StopAudio(eAudioTypeMusic);
}

if (Game.IsAudioPlaying(eAudioTypeAmbientSound)) {
  Game.StopAudio(eAudioTypeAmbientSound);
}

SetAmbientTint(0, 0, 0, 0, 100);


}
  





function hOutside_Interact()
{
cMap.ChangeRoom(7);
}

function hInside_Interact()
{
cMap.ChangeRoom(25);
}
