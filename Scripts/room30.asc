//ofOR.RemoveTint();
//ofPP.RemoveTint();
//ofS.RemoveTint();
//ofT.RemoveTint();
//ofD.RemoveTint();
//ofHB.RemoveTint();
//ofPN.RemoveTint();


Level1=1;





if (firstload==0) {
Mouse.Visible=false;  
FadeOut(10);
Wait(100);
firstload=1;
faded=1;


}

MMtimer=0;
   animating=0;
