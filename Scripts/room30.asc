function room_RepExec()
{
   

   
    if ((faded==1)||(SecondChance==1)||(GameOver==1)) {
     MMtimer=0;
     idleset=0;
     
     
   
   }
   else {
     MMtimer++;
     
    
   }
   
  
  
 if (cMainMenu.Animating==false && idleset==0) {
   
   

   
      animating=0;
      Continue.NormalGraphic=2669;
   NewGame.NormalGraphic=2671;
   Quit.NormalGraphic=2670;
   
  Continue.MouseOverGraphic=2681;
   NewGame.MouseOverGraphic=2683;
   Quit.MouseOverGraphic=2682;
   
   Continue.PushedGraphic=2693;
   NewGame.PushedGraphic=2695;
   Quit.PushedGraphic=2694;
   
   
   int randomframe = Random(60);
   
   
   if (faded==1)  {
     cMainMenu.LockView(297);
   }
   else {
   cMainMenu.LockView(292);
   }
   
   
   cMainMenu.Animate(0, 30, eRepeat, eNoBlock, eForwards);
    cMainMenu.Frame=randomframe;
    
    idleset=1;
    


  }
  
  
  
  
    #region//interruption timers
  
  if (MMtimer==200) {
    
   // RandomElder();
 
     
