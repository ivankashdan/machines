function room_FirstLoad()
{
  
 if (Game.GetSaveSlotDescription(1)!=null) {  
  
  
  firstload=1;
  
}

}



function room_Load()
{
  

//idleset=1;
MMtimer=0;



if (faded==1) {
   cMainMenu.LockView(297);
}
else {
 cMainMenu.LockView(292);
}
 
 
    cMainMenu.Animate(0, 30, eRepeat, eNoBlock, eForwards);

aPortal_bowl.Stop();

  
  
  lblAction.TextColor=65535;
   SetAmbientLightLevel(0);

  
  //Dfound=1;
  //FoundCounter=1;
  //PlayClicked=1;           //temporary!
  
 // faded=1;
  //firstload=1; ///tempororary to skip intro
  // GameOver=1;       //temporary!
  // SecondChance=1;
  
  
  
  
  
  if (firstload==1) {    //if save file exists
    
    Continue.Visible=true;
  }
  
  
  
  
  #region additional screen setups
  
  if (BeenHereBefore==1) {
       
             Quit.SetPosition(281, 128);
if (Game.IsAudioPlaying(eAudioTypeMusic)) {
  Game.StopAudio(eAudioTypeMusic);
}

if (Game.IsAudioPlaying(eAudioTypeAmbientSound)) {
  Game.StopAudio(eAudioTypeAmbientSound);
}

if (Game.IsAudioPlaying(eAudioTypeSound)) {
  Game.StopAudio(eAudioTypeSound);
}
     }
     
     
     
     else if (GameOver==1){ 
     }
     
     else if (SecondChance==1) {
       
       
     }
    
    
   #endregion 
    
     else {
     
       Quit.SetPosition(281, 128);
if (Game.IsAudioPlaying(eAudioTypeMusic)) {
  Game.StopAudio(eAudioTypeMusic);
}

if (Game.IsAudioPlaying(eAudioTypeAmbientSound)) {
  Game.StopAudio(eAudioTypeAmbientSound);
}

if (Game.IsAudioPlaying(eAudioTypeSound)) {
  Game.StopAudio(eAudioTypeSound);
}
  }
  
  
  
}



