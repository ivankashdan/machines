// room script file

int LGIdleCounter=0;
int PickupCounter=0;
int PickupClicked=0;
int PickupCounterHB=0;





function room_Load()
{
 
  
aSea_ambient.Play();

cDarkSea.Transparency=100;
hDarkness.Enabled=false;
Level1=1;

lblAction.TextColor=65535;
lblAction.Font=eFontFont4;


 cBlack.ChangeRoom(3);
 cBlack.Transparency=0;
 //cBlack.Transparency=0;
//cBlack.Baseline=10;


}




function repeatedly_execute_always() {
  
  
  
if (Hotspot.GetAtScreenXY(mouse.x, mouse.y)== hHBbobs) {
  Mouse.ChangeModeView(eModeWalkto, 227);
  
}

else if (Hotspot.GetAtScreenXY(mouse.x, mouse.y)== hZalron) {
  Mouse.ChangeModeView(eModeWalkto, 227);
  
  if (PickupCounter==1) {
    lblAction.Text="A clear glass ball, covered in hair";
  }
  
  
}


 else if  ( Hotspot.GetAtScreenXY(mouse.x, mouse.y)== hStation )




{
  Mouse.ChangeModeView(eModeWalkto, 228);
}

else {
  
  
  Mouse.ChangeModeView(eModeWalkto, 226);
}


  if (Button.GetAtScreenXY(mouse.x, mouse.y) == btnInvDown) {
  if ((HBfound==1)&&(Zfound==1)) {
  lblAction.Text="There are 0 items remaining in this room";
  }
  else if ((HBfound==1)&&(Zfound==0)) {
    lblAction.Text="There is 1 item remaining in this room";
  }
  else if ((HBfound==0)&&(Zfound==1)) {
    lblAction.Text="There is 1 item remaining in this room";
  }
    else if ((HBfound==0)&&(Zfound==0)) {
    lblAction.Text="There are 2 items remaining in this room";
  }
  
}
  
  
  
  
  
  
  
  
  
  
  cBlack.Baseline=5;
  rHBbobs.Baseline=2;
  rZ.Baseline=1;
}

function room_AfterFadeIn()
{
  
  
  if (Level1==1) {
if (HBfound==0) {
  rHBbobs.LockView(102);
  rHBbobs.Animate(0, 0,  eOnce);
  rHBbobs.UnlockView();
  rHBbobs.SetIdleView(102, 0);
}
if (Zfound==1) {
  rZ.ChangeRoom(11);
}
}
  
  Wait(50);

cBlack.ChangeRoom(11);
FadeIn(3);
  
  //Wait(10);


}



function hZalron_Interact()
{
 if (Stage3==1) {
cMap.ChangeRoom(28);

}
  
  else if (PickupCounter == 0) {
rZ.LockView(24);
rZ.Animate(0, 5, eOnce);
rZ.UnlockView(eKeepMoving);
rZ.SetIdleView(25, 0);
PickupCounter=1;
  }
  
  else
  {
    rZ.ChangeRoom(11);
    cMap.AddInventory(iZalron);
    aZ_land.Play();
    Zfound=1;
    //FoundCounter++;
    Displaytext();
    PickupCounter = 2;
    hZalron.Enabled=false;
    if (World1==1) {
      W1Zfound=1;
    }
}
}


function hHBbobs_Interact()
{
  
  if (World2==1) {
    if (PickupCounterHB==0) {
    rHBbobs.LockView(159);
    rHBbobs.Animate(0, 5, eOnce);
    rHBbobs.Animate(1, 10, eOnce);
    rHBbobs.UnlockView(eKeepMoving);
    rHBbobs.SetIdleView(159, 0);
    PickupCounterHB=1;
    }
  }
  
  
  else {
    rHBbobs.ChangeRoom(11);
    cMap.AddInventory(iHeliobrother);
    aHB_land.Play();
    HBfound=1;
    Displaytext();
    PickupCounterHB=2;
    hHBbobs.Enabled=false;
    W1HBfound=1;
    //FoundCounter++;
  }
  
  
  }

 





function hHotspot2_AnyClick()
{
  if (World2==1) {
    cMap.ChangeRoom(10);
    FadeOut(10);
  }
  else {
  
  
cMap.ChangeRoom(10);

}
}


function hDarkness_AnyClick()
{
cMap.ChangeRoom(28);
}



function room_RepExec()
{
  
 
  
  if (Stage3==1) {
    
//LG talking to himself
  
LGIdleCounter+=1;
cMap.x=280;
cMap.y=170;


if (LGIdleCounter==20) {
cMap.SayBackground("Run...");
 }
 
if (LGIdleCounter==100) {
cMap.SayBackground("Quiet...");
 }
 
  if (LGIdleCounter==220) {
cMap.SayBackground("Silence!");
 }
 
  if (LGIdleCounter==400) {
cMap.SayBackground("Do you...");
  }
  if (LGIdleCounter==700) {
cMap.SayBackground ("Do I...");
  }
  
if (LGIdleCounter==1000) {
cMap.SayBackground ("All...");
}
if (LGIdleCounter==1100) {
cMap.SayBackground ("Come...");
}

if (LGIdleCounter==1600) {
cMap.SayBackground ("Balderdash!");
}


if (LGIdleCounter==2000) {
cMap.SayBackground ("Want...");
}

if (LGIdleCounter==2300) {
cMap.SayBackground ("Work...");
}

if (LGIdleCounter==2900) {
  cMap.SayBackground ("Demands...");
}

if (LGIdleCounter==3000) {
  cMap.SayBackground ("Oh!");
}
  
if (LGIdleCounter==3200) {
  
  LGIdleCounter=0;
}}}






