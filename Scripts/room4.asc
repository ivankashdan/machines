function repeatedly_execute_always()

{
  
  
  #region// mouse hover icon
 if  ( Character.GetAtScreenXY(mouse.x, mouse.y)== rD)

{
  Mouse.ChangeModeGraphic(eModeWalkto, 1805);
}


   else if  ( Hotspot.GetAtScreenXY(mouse.x, mouse.y)== hHose)
 

{
  Mouse.ChangeModeGraphic(eModeWalkto, 1806);
}


else if  (( Hotspot.GetAtScreenXY(mouse.x, mouse.y)== hHotspot3)
  || ( Hotspot.GetAtScreenXY(mouse.x, mouse.y)== hHotspot4)
   || ( Hotspot.GetAtScreenXY(mouse.x, mouse.y)== hHotspot5)
|| ( Hotspot.GetAtScreenXY(mouse.x, mouse.y)== hPot))
{
  Mouse.ChangeModeGraphic(eModeWalkto, 1808);
}

  else
{
  
 Mouse.ChangeModeGraphic(eModeWalkto, 2061);
 }

 #endregion
  
 
 
   cWhite.Baseline=10;
  cYardMist.Baseline=2;
  //cDPickup.Baseline=3;
  rD.Baseline=3;
  //cYardMist2.Baseline=4;
 cBlack.Baseline=20;
 
 
}


