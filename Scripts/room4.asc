function hHose_Interact()
{
  
  IdleHeld=1;
  IdleTimer=0;
  
  
  if (HoseTalk==0) {
    
   Wait(10);
    cMap.Say("Take the diamond, dear...");
  
  
  //cMap.Say("It is yours now");
  //cMap.Say("The diamond is yours now");
  //cMap.Say("May it protect you on your travels, as it once protected me");
  //Wait(10);
  //cMap.Say("But you need a little something to get your started");
  HoseTalk=1;
  }
  
  
  
  else if (HoseTalk==1) {
    
       Wait(10);
    cMap.Say("It's not much I know...");
    Wait(30);
      cMap.Say("But it's important to me that you carry this");
    
  
    HoseTalk=0;
  }
  
   else if (HoseTalk==2) {
 
   Wait(10);
  cMap.Say("You are ready to leave, and find your fortune at last");
    
 
    //cMap.Say("But... please accept it");
    //cMap.Say("But it's all I have left");
  
    HoseTalk=0;
  }
  
  
   else if (HoseTalk==3) {
     Wait(10);
    //cMap.Say("Darling..?");
    HoseTalk=4;
  }
  
   else if (HoseTalk==4) {
     Wait(10);
    //cMap.Say("I can wait until you are ready");
    Wait(30);
    //cMap.Say("After all, we have been waiting for a very long time...");
    HoseTalk=5;
  }
  

  


}
