    IdleHeld=0;
    IdleTimer=0;
  }
  
  
    if (IdleHeld==1) {
    IdleTimer++;
      
    }


  
  else if (Ddropped==1) {          //idle dialogue
  
TakeD+=1;
//lblAction.Text="Click on the diamond to pick it up";

if (TakeD==500) {
  
  //cMap.SayBackground ("Take the diamond dear...");
  }
  
   if (TakeD==800) {
     
     
     //cMap.SayBackground ("It's not much I know...");
     cMap.SayBackground ("Darling..?");
  }
