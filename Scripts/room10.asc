    hHotspot2_Interact();
    
  }
      }
  
  
    if (cMap.ActiveInventory == iPR) {fbPRCounter=1;
    Place.Visible = false;
    cMap.LoseInventory(iPR);
    
    int ran=Random(3);
    if (ran<3) { bPR.Visible = true;
    aPR_landN.Play();
    aPR_land.Play();
