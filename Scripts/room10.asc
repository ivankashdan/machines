function room_Leave()
{
  lblAction.TextColor=0;
  lblAction.Font=eFontFont3;
 InformationMode=0;
  

//GirderCounter=0;
//cGirder1.SetIdleView(30, 0);

//Girderappears=0;
  

 if (PapersCounter==0) {
RefreshG();
 
  if (cGate.Room==10) 
  {
  cGate.ChangeRoom(11);
    
  }
 }

if (Game.IsAudioPlaying(eAudioTypeAmbientSound)) {
  Game.StopAudio(eAudioTypeAmbientSound);
}

if (Game.IsAudioPlaying(eAudioTypeMusic)) {
  Game.StopAudio(eAudioTypeMusic);
}

aPortal_bowl.Stop();


if (bSG.Visible==true) {
  bSG.Visible=false;
  
}






if (cOR_G.Room==10) {
  cOR_G.ChangeRoom(11);
  PapersCounter=0;
  if (cMap.HasInventory(iOR)==false) {
  cMap.AddInventory(iOR);
  }
}


}

function hGate_AnyClick()
{
cMap.ChangeRoom(13);
FadeOut(100);
  cGate.ChangeRoom(11);
  PortalOpen=0;
  aPortal_bowl.Stop();
  RefreshG();
  PapersCounter=0;
Wait(50);
}

  
  
