function room_Load()
{

lblAction.TextColor=65535;
lblAction.Font=eFontFont4;

lblAction.Visible=true;


if (Level1==1) {
  
  if (GirderCounter==0) {
    
  cGirder1.Transparency=100;
  cGirder1.Clickable=false;
  }
  SEndCounter=1;
  hGate.Enabled=false;
  hHotspot2.Enabled=true;
  hCity.Enabled=true;
  //bLG.Visible=false;
  Place.Visible=false;
  hPlace.Enabled=false;
  
  cGirder1.Baseline=1;
   
    }
    
    else { 
    cGirder1.Transparency=0;
    bLG.Visible=false;
    hCity.Enabled=true;
    }
    

  aRailroad_ambient.Play();

  







if (cMap.PreviousRoom==21) 
  {
    FadeIn(10);
  }
  
  
  
  if (World1==0) {
  
  if ((PapersCounter==1)&&(bLG.Visible==true)) { //Gate open if LG is present & PapersCounter=1
 hGate.Enabled=true;
}
else { hGate.Enabled=false;}
  if (PortalOpen==1) 
  {
    aPortal_bowl.Play();
  }
  }
  
  
  if (LGfound==0) {
    bLG.Visible=true;
  }
  

}


//Refresh code
function RefreshG() 
{
  CollapseCounter=0;
  fbPNCounter=0;
  fbSCounter=0;
  fbTCounter=0;
  fbORCounter=0;
  fbPRCounter=0;
  fbZCounter=0;
  fbPPCounter=0;
  fbPPSCounter=0;
  fbLGCounter=0;
  fbDCounter=0;
  fbHBCounter=0;
  Emptied=0;
  Collapsed=0;
  CollapsedRoom=0;
  StageCounter=0;
 
 if (GirderCounter==0) {
  Place.Visible = true;
  hPlace.Enabled = true;
  
 }
  
  bD.Visible=false;
  bHB.Visible=false;
  bLG.Visible=false;
  bPP.Visible=false;
  bPPS.Visible=false;
  bPN.Visible=false;
  bS.Visible=false;
  bT.Visible=false;
  bPR.Visible=false;
  bPR2.Visible=false;
  bZ.Visible=false;
  
  bfD.Visible=false;
  bfHB.Visible=false;
  bfLG.Visible=false;
  bfPP.Visible=false;
  bfPPS.Visible=false;
  bfPN.Visible=false;
  bfS.Visible=false;
  bfT.Visible=false;
  bfOR.Visible=false;
  bfPR.Visible=false;
  bfZ.Visible=false;
 
  cMap.LoseInventory(iLG);
  cMap.LoseInventory(iPearl);
  cMap.LoseInventory(iHeliobrother);
  cMap.LoseInventory(iDiamond);
  cMap.LoseInventory(iZalron);
  cMap.LoseInventory(iPR);
  cMap.LoseInventory(iOR);
  cMap.LoseInventory(iT);
  
    if (PPSCounter == 1) {
    cMap.LoseInventory(iSpiraly);
  cMap.LoseInventory(iPP);
    }
  if (PPSCounter == 0) {
  cMap.LoseInventory(iSpiraly);
  cMap.LoseInventory(iPP);
  cMap.LoseInventory(iPP_S);
  }
  
  
  //Add inventory objects if FOUND
 
     if (LGfound==1) {
  cMap.AddInventory(iLG);
   }
      if (PNfound==1) {
  cMap.AddInventory (iPearl);
      }
         if (HBfound==1) {
  cMap.AddInventory(iHeliobrother);
         }
            if (Dfound==1) {
  cMap.AddInventory(iDiamond);
            }
               if (Zfound==1) {
  cMap.AddInventory(iZalron);
               }
                  if (PRfound==1) {
  cMap.AddInventory(iPR);
                  }
                     if (Tfound==1) {
  cMap.AddInventory(iT);
                     }
  if ((PapersCounter==0) && (ORfound==1)) {
  cMap.AddInventory(iOR);
  }
  if ((PPSCounter == 1) &&  (Sfound==1)) {
  cMap.AddInventory(iSpiraly);
    }
  if ((PPSCounter ==1) &&  (PPfound==1)) {
    cMap.AddInventory(iPP);
  }
  if ((PPSCounter == 0) &&  ( PPfound==1) &&   (Sfound==1)) {
  cMap.AddInventory(iPP_S);
  }
  if (LeaveCounter==0) {
  //Fades - would go here 
  }
}


function repeatedly_execute_always()
{





if (Object.GetAtScreenXY(mouse.x, mouse.y)== bLG) {
  Mouse.ChangeModeView(eModeWalkto, 227);
  
}

else if (Object.GetAtScreenXY(mouse.x, mouse.y)== bSG) {
  Mouse.ChangeModeView(eModeWalkto, 227);
  
}

else if (Character.GetAtScreenXY(mouse.x, mouse.y)== cOR_G) {
  Mouse.ChangeModeView(eModeWalkto, 227);
  
}


else if (Character.GetAtScreenXY(mouse.x, mouse.y)== cGirder1) {
  Mouse.ChangeModeView(eModeWalkto, 229);
  
}

 else if  (( Hotspot.GetAtScreenXY(mouse.x, mouse.y)== hHotspot2 )
 ||
 ( Hotspot.GetAtScreenXY(mouse.x, mouse.y)== hCity ))



{
  Mouse.ChangeModeView(eModeWalkto, 228);
}





else {
  
  
  Mouse.ChangeModeView(eModeWalkto, 226);
}



if (cGirder1.Speaking==true) {
    lblAction.Text="";
  }
    
    
    if (Button.GetAtScreenXY(mouse.x, mouse.y) == btnInvDown) {
  if (LGfound==1) {
  lblAction.Text="There are 0 items remaining in this room";
  }
  else {
    lblAction.Text="There is 1 item remaining in this room";
  }
  
}

  
if ((World2==1)&&(InformationMode==1)&&(StageCounter==0)) {
  Place.Visible=true;
  hPlace.Enabled=true;
  Place.Clickable=false;
  
}
else {
   Place.Visible=false;
  hPlace.Enabled=false;
  Place.Clickable=false;
}
  
  
   if((Hotspot.GetAtScreenXY(mouse.x, mouse.y)== hCity) || (Hotspot.GetAtScreenXY(mouse.x, mouse.y)== hHotspot2) || (lblAction.Text=="New Object found")) {
  } 
  else if (Game.GetLocationName(mouse.x,  mouse.y) != null) {
    //lblAction.Text="";
    }
  
  
  
  if ((CollapseCounter ==1)&&(Collapsed==0)) {
    StageCounter=0;
    
      //BIGGIE Objects. 
  
      if (fbPNCounter ==1) 
      { 
          object[19].Visible=true;
      }
          
      if (fbSCounter ==1) 
      { 
          object[9].Visible=true;
      }
      if (fbTCounter ==1) 
      { 
          object[22].Visible=true;
      }
      if (fbORCounter == 1) 
      { 
          
      }
      if (fbPRCounter == 1) 
      { 
          object[21].Visible=true;
      }
      if (fbZCounter == 1) 
      { 
          object[23].Visible=true;
      }
      if (fbPPCounter ==1) 
      { 
          object[20].Visible=true;
      }
      if (fbLGCounter == 1) 
      { 
          object[18].Visible=true;
      }
      if (fbHBCounter == 1) 
      { 
          object[17].Visible=true;
      }
      if (fbDCounter == 1) 
      { 
          object[16].Visible=true;
      }
      if (fbPPSCounter == 1) 
      { 
          object[24].Visible=true;
      }
      
      
      
      
      //BIGGIE Objects.  
      if (Emptied==0) {
     
       
        if (player.ActiveInventory==iHeliobrother) {
       player.ActiveInventory=null;
       player.LoseInventory(iHeliobrother);
       object[17].Visible=true;
     }
     else if (player.ActiveInventory==iT) {
       player.ActiveInventory=null;
       player.LoseInventory(iT);
       object[22].Visible=true;
     }
     else if (player.ActiveInventory==iOR) {
       player.ActiveInventory=null;
       player.LoseInventory(iOR);
       object[25].Visible=true;
     }
     else if (player.ActiveInventory==iSpiraly) {
       player.ActiveInventory=null;
       player.LoseInventory(iSpiraly);
       if (object[9].Visible==false) {
       object[26].Visible=true;
       }
     }
     else if (player.ActiveInventory==iPP) {
       player.ActiveInventory=null;
       player.LoseInventory(iPP);
       object[20].Visible=true;
     }
     else if (player.ActiveInventory==iZalron) {
       player.ActiveInventory=null;
       player.LoseInventory(iZalron);
       object[23].Visible=true;
     }
     else if (player.ActiveInventory==iDiamond) {
       player.ActiveInventory=null;
       player.LoseInventory(iDiamond);
       object[16].Visible=true;
     }
     else if (player.ActiveInventory==iPearl) {
       player.ActiveInventory=null;
       player.LoseInventory(iPearl);
       object[19].Visible=true;
     }
     else if (player.ActiveInventory==iLG) {
       player.ActiveInventory=null;
       player.LoseInventory(iLG);
       object[18].Visible=true;
     }
     else if (player.ActiveInventory==iPR) {
       player.ActiveInventory=null;
       player.LoseInventory(iPR);
       object[21].Visible=true;
     }
     else if (player.ActiveInventory==iPP_S) {
       player.ActiveInventory=null;
       player.LoseInventory(iPP_S);
       object[24].Visible=true;
     }
     }
       Emptied=1;
    Collapsed=1;
      
  }
    
    
    
  
if ((CollapseCounter == 1)&&(CollapsedRoom==0)) {//Collapse code

    bD.Visible=false;
  bHB.Visible=false;
  bLG.Visible=false;
  bPP.Visible=false;
  bPPS.Visible=false;
  bPN.Visible=false;
  bS.Visible=false;
  bT.Visible=false;
  bPR.Visible=false;
  bPR2.Visible=false;
  bZ.Visible=false;
  
  
     
  CollapsedRoom=1;
}


//Place reappearance script, if board is empty
  
  
   if (
  (Girderappears==1) &&
  (bfD.Visible==false) &&
  (bfHB.Visible==false) &&
  (bfLG.Visible==false) &&
  (bfPP.Visible==false) &&
  (bfPPS.Visible==false) &&
  (bfPN.Visible==false) &&
  (bfS.Visible==false) &&
  (bSG.Visible==false) &&
  (bfT.Visible==false) &&
  (bfOR.Visible==false) &&
  (PapersCounter==0) &&
  (bfPR.Visible==false) &&
    (bfZ.Visible==false) &&
    (CollapsedRoom==1))
  {
    StageCounter=0;
    RefreshG();
   
  }



}






function hHotspot2_MouseMove() //Hover over the Sea
{
  
}


function hHotspot2_Interact()
{
  
  if (LGfound==0) {
    
     cMap.ChangeRoom(3);
    FadeOut(10);
    return;
    
  }
    
    if (LGfound==1) {
    
    cGirder1.Transparency=0;

if (GirderCounter==0){
  InformationMode=0;
  Girderappears=1;
Place.Visible=false;
hPlace.Enabled=false;
aGirder_up.Play();
CollapseCounter=1;
  bD.Visible=false;
  bHB.Visible=false;
  bLG.Visible=false;
  bPP.Visible=false;
  bPPS.Visible=false;
  bPN.Visible=false;
  bS.Visible=false;
  bT.Visible=false;
  bPR.Visible=false;
  bPR2.Visible=false;
  bZ.Visible=false;
cGirder1.LockView(28);
cGirder1.Animate(0, 1, eOnce);
cGirder1.UnlockView();
cGirder1.SetIdleView(29, 0);
GirderCounter=1;
cGirder1.Clickable=true;

 if (Description==0) {
aGirder_speaks2.Play();


if (bS.Visible==true) {
  cGirder1.Say("AHHHH!");
  
}
else {
cGirder1.Say("Papers please...");
}

 }
 
 Description=0;
 }


  else if (cGirder1.Transparency==100) {    ///go to Promenade if Girder is out of order
    cMap.ChangeRoom(3);
    FadeOut(10); 
  }
  
  else if (PapersCounter==0){
    aGirder_speaks2.Play();
cGirder1.Say("Papers please...");
  }
  
  else if (PapersCounter==1) {
    
      if (World2==1) {
    cMap.ChangeRoom(3);
    FadeOut(10);
    
  }
  else {
    
cMap.ChangeRoom(3);
FadeOut(10);
  }
  
  }
}



}




//Stage 1 

function hPlace_UseInv()
{
   Place.Visible = false;
   hPlace.Enabled = false;
   StageCounter=1;
   if (Game.IsAudioPlaying(eAudioTypeMusic)==false) {
   aTerrain_loop1.Play();
   }
   
   

  if (cMap.ActiveInventory == iHeliobrother) {fbHBCounter=1;
    Place.Visible = false;
    bHB.Visible = true;
    aHB_land.Play();
    cMap.LoseInventory(iHeliobrother);
    if (SEndCounter==0) {
    Wait(40);
    aGirder_covered.Play();
     cGirder1.Say("Citizen detected.");
     cGirder1.Say("Scanning records...");
     Wait(50);
     cGirder1.Say("Name: HB-112 [Occupation: Retired");
     cGirder1.Say("Previous employment: Royal guard");
     cGirder1.Say("Address: Unknown.");
     cGirder1.Say("Taxes: Exempt.");
     cGirder1.Say("Excerpt from royal decree:[All automatons constructed to defend the realm, are hereby granted citizenship");
     cGirder1.Say("To celebrate their years of service, and furlough pay to cover repairs");
     cGirder1.Say("For one lifetime.");
     
     cGirder1.Say("*Stop*");
     Description=1;
     hHotspot2_Interact();
    }
  }
  if (cMap.ActiveInventory == iLG) { fbLGCounter=1;
    PapersCounter=1;
    Place.Visible = false;
    bLG.Visible = true;
    cMap.LoseInventory(iLG);
    aLG_land.Play();
    ShakeScreenBackground(4, 5, 40);
    if (SEndCounter==0) {
   Wait(40);
    aGirder_covered.Play();
     cGirder1.Say("Citizen detected.");
     cGirder1.Say("Scanning records...");
     Game.StopAudio(eAudioTypeMusic);
     Wait(50);
     if (RecordsUpdated==0) {
     cGirder1.Say("Subject is missing.");
     cGirder1.Say("Records...");
     cGirder1.Say("*Updated*");
     RecordsUpdated=1;
     Wait(50);
     }
      aDay1_lady_loop4.Play();
     cGirder1.Say("Name: Lord Gourd");
     cGirder1.Say("Occupation: Royal");
     cGirder1.Say("Prerecorded message:[Welcome home, my lord.");
     cGirder1.Say("We have long been awaiting your return. The people will be overjoyed");
     cGirder1.Say("The old passage under the castle remains open. Your presence is awaited in the throne room.");
     cGirder1.Say("End of recorded message");
     cGirder1.Say("Opening Gate..."); 
     ShakeScreen(5);
     cGate.ChangeRoom(10);
     cGate.Baseline=1;
     bLG.Baseline=3;
     Place.Baseline=3;
     cGirder1.Baseline=2;
     cGate.LockView(130);
     cGate.Animate(0, 4, eOnce);
     cGate.Animate(1, 5, eOnce);
     cGate.UnlockView();
     cGate.SetIdleView(130, 0);
     PortalOpen=1;
     aPortal_bowl.Play();
     cGirder1.Say("*Stop*");
     Description=1;
     hGate.Enabled=true;
     
   }
  }
  if (cMap.ActiveInventory == iDiamond) {fbDCounter=1;
    Place.Visible = false;
    bD.Visible = true;
    cMap.LoseInventory(iDiamond);
    aD_land2.Play();
    if (SEndCounter==0) {
    Wait(40);
        
     aGirder_speaks.Play();
     Description=1;
     hHotspot2_Interact();
     cGirder1.Say("Alert! Traces of controlled substance detected.");
     aGirder_speaks2.Play();
     cGirder1.Say("*Stop*");
     aGirder_up.Play();
cGirder1.LockView(28);
cGirder1.Animate(1, 1, eOnce);
cGirder1.LockView(30);
cGirder1.Animate(0, 1, eOnce);
cGirder1.UnlockView();
cGirder1.SetIdleView(30, 0);
GirderCounter=0;
cGirder1.Clickable=false;
object[14].Visible=false;
object[15].Visible=false;
hotspot[5].Enabled=false;
     aGirder_covered.Play();
     cGirder1.Say("The authorities have been contacted.");
     cGirder1.Say("Please wait here to be apprehended.");
    
     Description=1;
  }
  }
    if (cMap.ActiveInventory == iPearl) { fbPNCounter=1;
    Place.Visible = false;
    bPN.Visible = true;
    cMap.LoseInventory(iPearl);
    aPN_land2.Play();
    if (SEndCounter==0) {
  aGirder_speaks2.Play();
    cGirder1.Say("This is the longest I've seen her stand still...");
  }
    }
  if (cMap.ActiveInventory == iPP) { fbPPCounter=1;
    Place.Visible = false;
    bPP.Visible = true;
    cMap.LoseInventory(iPP);
    aPP_land.Play();
    if (SEndCounter==0) {
      Wait(40);
  aGirder_covered.Play();
     cGirder1.Say("Animal life detected.");
     cGirder1.Say("Scanning records...");
     Wait(50);
     aGirder_speaks.Play();
     cGirder1.Say("*Error*");
