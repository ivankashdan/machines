     cGirder1.Say("as a result of deforestation in the precious old growth regions around The City.");

     cGirder1.Say("*Stop*");
     Description=1;
     hHotspot2_Interact();
  }
  }
    if (cMap.ActiveInventory == iZalron) {fbZCounter=1;
    Place.Visible = false;
    bZ.Visible = true;
    cMap.LoseInventory(iZalron);
    aZ_land.Play();
    if (SEndCounter==0) {
      Wait(40);
        aGirder_covered.Play();
     cGirder1.Say("Citizen detected.");
     cGirder1.Say("Scanning records...");
     Wait(50);
     cGirder1.Say("Name: Zalagius Sal Rochenberger");
     aGirder_speaks.Play();
     Description=1;
     hHotspot2_Interact();
     cGirder1.Say("Alert! Exile within city limits");
     cGirder1.Say("Sentence of 6300 years for multiple counts of theft, trespassing, vandalism,  criminal contempt of court, conspiracy,"); 
     cGirder1.Say("harassment, disorderly conduct, public intoxication, indecent exposure,");
     cGirder1.Say("shoplifting, solicitation, fraud, forgery,  identity theft, tax evasion, disturbing the peace...");
     cGirder1.Say("and probation violation."); 
  
     cGirder1.Say("*Stop*");
     aGirder_up.Play();
cGirder1.LockView(28);
cGirder1.Animate(1, 1, eOnce);
cGirder1.LockView(30);
cGirder1.Animate(0, 1, eOnce);
cGirder1.UnlockView();
cGirder1.SetIdleView(30, 0);
GirderCounter=0;
cGirder1.Clickable=false;
object[14].Visible=false;
object[15].Visible=false;
hotspot[5].Enabled=false;
     aGirder_covered.Play();
     cGirder1.Say("The authorities have been contacted.");
     cGirder1.Say("Please wait here to be apprehended.");
    
     Description=1;
  }
    }
      if (cMap.ActiveInventory == iSpiraly) {fbSCounter=1;
    Place.Visible = false;
    bS.Visible = true;
    cMap.LoseInventory(iSpiraly);
    aS_land1.Play();
    if (SEndCounter==0) {
      Wait(40);
    aGirder_covered.Play();
    cGirder1.Say("Object detected.");
    cGirder1.Say("Scanning records...");
    Wait(50);
    cGirder1.Say("A high-security holding cell custom-made for a specific inmate.");
    cGirder1.Say("This item was reported missing [311 days ago.");
    cGirder1.Say("Please return to the community detention centre immediately.");
    cGirder1.Say("Following this - please locate the nearest law official to confess your crimes,");
    cGirder1.Say("which will be weighed and an appropriate sentence served");
    cGirder1.Say("*Stop*");
    Description=1;
    hHotspot2_Interact();
    }
  }
        if (cMap.ActiveInventory == iOR) {fbORCounter=1;
    Place.Visible = false;
    cOR_G.ChangeRoom(10);
    cMap.LoseInventory(iOR);
    aOR_land.Play();
    PapersCounter=1;
    if (SEndCounter==0) {
      Wait(40);
    aGirder_covered.Play();
     cGirder1.Say("Citizen detected.");
     cGirder1.Say("Scanning records...");
     Wait(50);
     cGirder1.Say("Name: Roland Tilley");
     cGirder1.Say("Occupation: Retired");
     cGirder1.Say("Previous employment: Sherrif for 45 years");
     cGirder1.Say("Registered address in city."); 
     cGirder1.Say("Taxes: Up to date. Immaculate record.");
     cGirder1.Say("Personal description: By all accounts, an upstanding member of the community"); 
     cGirder1.Say("who dedicated his professional life to protecting The City from threats inside and outside the walls.");
     cGirder1.Say("Continues to be an active member of the neighbourhood watch...");
     cGirder1.Say("... a pleasure to serve you again.");
     
     cGirder1.Say("*Stop*");
     Description=1;
     hHotspot2_Interact();
     
    
    
    }
  }
          if (cMap.ActiveInventory == iT) {fbTCounter=1;
    Place.Visible = false;
    bT.Visible = true;
    cMap.LoseInventory(iT);
    aT_land.Play();
    if (SEndCounter==0) {
      Wait(40);
     aGirder_covered.Play();
     cGirder1.Say("Citizen detected.");
     cGirder1.Say("Scanning records...");
     Wait(50);
     cGirder1.Say("Name: Tilda Woods");
     cGirder1.Say("Occupation: Retired");
     cGirder1.Say("Previous employment: Law enforcement");
     cGirder1.Say("Registered address in city.[Rent overdue 3 months."); 
     cGirder1.Say("Taxes: Up to date. Paid in advance.");
     cGirder1.Say("Personal description:[Miss Woods has provided exemplary service to The City");
