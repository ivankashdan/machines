    aGirder_speaks2.Play(); cGirder1.Say("Keep trying."); } }
   
    else if (ran==3) {bPR2.Visible = true;
    aPR_land.Play(); 
    aPR_landP.Play();
    if (SEndCounter==0) {
 
    aGirder_speaks2.Play(); cGirder1.Say("I told you there was something special about that one.");
    
    } } }
