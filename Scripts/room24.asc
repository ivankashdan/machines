function TakeOR() {
  
  if (ORfound==0) {
    
       if (takeapart==1) {
          int i = 0;
 while (i < ObjectivesList.ItemCount) // search from first to last item
 {
    if (ObjectivesList.Items[i] == "Smash up the entire neighbourhood")
    {
       // found it!
       ObjectivesList.RemoveItem(i); // remove this item
       i = ObjectivesList.ItemCount; // a trick to end the loop right away
    }
    i++; // next item...
}
   //ObjectivesList.RemoveItem("Smash up the entire neighbourhood")
   CompletedList.InsertItemAt(0,"Smash up the entire neighbourhood");
   }
   
    
    ORfound=1;
cMap.AddInventory(iOR);
aOR_land.Play();
Displaytext();
  //FoundCounter++;
  
  
  
  additem();


cInboxfalls.Transparency=0;
cInboxfalls.LockView(157, eKeepMoving);
cInboxfalls.Animate(0, 5, eOnce, eBlock);
cInboxfalls.Animate(1, 5, eOnce, eBlock);
cInboxfalls.UnlockView();
cInboxfalls.SetIdleView(157, 0);
hInboxfalls.Enabled=false;
hInbox2.Enabled=false;
  W1ORfound=1;


  W2ORfound=1;
  //Wait(10);
  //Wait(30);
   //additem();

  
  
  
  //Wait(100);
  //game.bgspeech_stay_on_display=1;
  //cInbox1.SayBackground("0.0");
  //Wait(50);
  cInbox3.SayBackground("I can't believe you've done this.");
  cInbox1.SayBackground("( + _ + )");
  
 // Wait(50);
  // game.bgspeech_stay_on_display=0;
  cantbelieve=1;
  horrified=1;
  lblAction.Text="";
  //Wait(200);
  }
}


