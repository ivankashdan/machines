function room_RepExec()
{


 if (horrified==1 && horrortimer<200) {
   
   
    cInbox1.SayBackground("( + _ + )");
    RedHeld=1;
    horrortimer++;
  }
  
  

  if (Postbox1clicked!=0) {
    Clicktimer++;
    
  }
  
  if (Clicktimer==200) {
    
    
    Postbox1clicked=0;
    Clicktimer=0;
  }






      if (IdleTimer>100) {
    
    IdleHeld=0;
    
    IdleTimer=0;
  }
  
  
    if (IdleHeld==1) {
    IdleTimer++;
      
    }
    
    
   
 if ((Postbox1clicked==7)&&(nothere==0)) {
    
 

 if (jibber!=2) {
    Speech.SkipStyle=eSkipTime;
    
     aGirder_speaks.Play();
     //Wait(20);
     lblAction.Text="";
     redeyes=1;
      cRedEyes.ChangeRoom(24);
    
     RedHeld=1;
 }
        
     
    if (jibber==0) {
     
   cInbox3.SayBackground("Shut up!");
   
   jibber=1;
    }
    else if (jibber==1) {
      cRedEyes.ChangeRoom(11);
       cInbox3.SayBackground("IMBECIL!");
      
      

      jibber=2;
    }
    /// else if (jibber==2) {

     // cInbox3.SayBackground("GOD DAMN IT SHUT UP!");
    //  jibber=3;
   /// }
  
  
   
    Speech.SkipStyle=eSkipMouseTime;
    redeyes=0;
    
    Postbox1clicked=0;
    
    
   
  }

    

                              //^^preparations for idle dialogue - remember to make 'else if'
                           

  
  
  
}





