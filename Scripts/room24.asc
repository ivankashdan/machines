     cInboxPN.LockView(116);
      cInboxPN.Animate(2, 0, eOnce);
      cInboxPN.UnlockView();
      cInboxPN.SetIdleView(116, 0);
      
     
  hInbox1.Enabled=false;
  }
  
  
  



}


}



