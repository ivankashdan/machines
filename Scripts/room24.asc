function room_Load()
{
  
  
  if (ORfound==0) {
    
    //aObject_present_cowbell.Play();
  }
  
  
 IdleHeld=0;
  
   Place.Visible=false;
  hPlace.Enabled=false;

//hHotspot2.Enabled=false;

  Refresh();
     
     //hInbox1.Enabled=false;
     //hInbox2.Enabled=false;
     //hInbox3.Enabled=false;
     

rOR.ChangeRoom(11);
rORfar.ChangeRoom(11);
//cInboxfalls.Transparency=100;
//cInboxPN.Transparency=100;




  if (ORfound==1) {
    cInboxfalls.Transparency=0;
  hInboxfalls.Enabled=false;
  cInboxfalls.LockView(157, eKeepMoving);
  cInboxfalls.Animate(1, 10, eOnce, eNoBlock);
  cInboxfalls.SetIdleView(157, 0);
  
  }
  else {
    cInboxfalls.Transparency=100;
  }


if (PathwayBuild==1) {



 hInboxfalls.Enabled=false; 
  
  
  if ((PNcollected==1)&&(W1PNfound==0))
  {cInboxPN.ChangeRoom(24);
     cInboxPN.Transparency=0;
     cInboxPN.LockView(116);
      cInboxPN.Animate(1, 0, eOnce);
