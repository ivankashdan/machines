function room_Load()
{
  
    //Tfound=1;    //temporary
 // WorldTreeDead=1;   //temporary
  
  
  if (GrowthCount==0) {
    GrowthCount=1;
  }
  
  
  IdleHeld=0;
  
  if ((WorldTreeDead==1)&&(familiarshapes==3)) {
    cloudcount+=1;
  }
  cloudwatch=0;

  
  
    if (cMap.PreviousRoom==6) {
      
      PicnicLost=0;
      
      
    }
  
  
  if (cMap.PreviousRoom==1) {

Refresh();



PlaceActive=0;
whirliplaced=0;
hic=0;



  }

  if (WorldTreeDead==0) {
   aOpen_wind_ambient.Play();
  } 
  else{
   aBirdplanes_ambient.Play();
  }


  
  
 Place.Visible=false;
  hPlace.Enabled=false;


  Refresh();
     
     if (PRmessage==1) {
       Wait(30);
       lblAction.Visible=true;
    aPR_land.Play();
    //lblAction.Text="Tic collected";
    Wait(80);
    lblAction.Text="";
    PRmessage=0;
     }
    

  
  
  //hProne.Enabled=false;
    //hProne2.Enabled=false;
    
 


if (WorldTreeDead==0) {
    
    cBollardSlow.Transparency=100;
 
}

else if (WorldTreeDead==1) {

   cBollardSlow.Baseline=1;
  cBollardSlow.Transparency=0;
  cBollardSlow.SetIdleView(62, 0);
  
  //hProne.Enabled=true;
    //hProne2.Enabled=true;
  
  
}





  

}



function room_AfterFadeIn()
{ 



  
  
  



  if ((PNfound==1)&&(ladymessage==0)) {
    Wait(50);
    cProne.SayBackground("The Lady... has fallen");
    cProne2.SayBackground("The Lady... has fallen");
    
    Wait(50);
      cProne.SayBackground("The Lady... has fallen");
    cProne2.SayBackground("The Lady... has fallen");
    Wait(50);
     Wait(50);
   // cProne.Say("As did we... so long ago");
    cProne.Say("As have we");
    Wait(30);
    
    //cProne.SayBackground("And we are still falling.");
    cProne2.Say("And we are still falling.");
    
    Wait(50);
    Wait(50);
   // cProne.Say("It is time for us to follow her into the long dark.");
    //cProne.Say("Into the silence...");
    //Wait(50);
    //cProne2.Say("But before we go. A message was beholden to us");
    
   // cProne.Say("At last we will touch ground.");
   //cProne.Say("Now, at last. I think we will touch ground");
   cProne.Say("She has left for you a message, through the ages...");
    
    //cProne2.Say("But there was a message");
    //cProne.Say("Passed down through the ages");
    //cProne2.Say("To reach you.");
     Wait(50);
     aPortal_bowl.Play();
     Wait(50);
     cProne2.Say("Do not mourn me, child.");
     cProne2.Say("Whatever path I chose, was my decision to make");
     //cProne2.Say("For I am very old, and wise beyond years.");
     Wait(30);
     cProne2.Say("I have lost very much, [and to lose a little more");
     ///cProne2.Say("Is but a little more.");
     cProne2.Say("It is... but the smallest chance");
     cProne2.Say("Worth taking.");
     
      Wait(30);
     // cProne2.Say("To ensure... the future of this land");
     // cProne2.Say("Even if it is but the smallest chance");
     // cProne2.Say("It is a chance... worth taking.");
      
    cProne2.Say("Do not fear, child.");
    cProne2.Say("All will become clear...");
    Wait(50);
    aPortal_bowl.Stop();
    cProne.Say("End of message.");
    
  
    ladymessage=1;
  }


  if ((OutlineShown==1)&&(Ladyhasfallen==0)) {
  Wait(50);
cProne.Say("The Lady...");
cProne.Say("Has fallen");
//Wait(50);
//cProne.Say("At last.");
Ladyhasfallen=1;
  }
  
 
 
 if ((PRfound==1)&&(pronecomment==0)) {
  cProne2.Say("Oh!");
  cProne2.Say("You appear to have a tic on you");
  pronecomment=1;
  
}

}




