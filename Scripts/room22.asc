function room_RepExec()
{
      

 
 
 
   if (IdleTimer>100) {
    
    IdleHeld=0;
    IdleTimer=0;
  }
  
  
    if (IdleHeld==1) {
    IdleTimer++;
      
    }
    
    
    
     else if ((cloudcount!=0)&&(PNfound==0)) {
   cloudwatch++;
 
    
          if (cloudcount==1) {               
      
    
if (cloudwatch==20) {
cProne.SayBackground("There!");
 }

  if (cloudwatch==60) {
cProne2.SayBackground ("What?");
  }
if (cloudwatch==250) {
cProne.SayBackground ("Did you see it?");
}
if (cloudwatch==500) {
cProne.SayBackground ("That one looked like a crocodile");
}


    
}

else if (cloudcount==3) {   


  

    if (cloudwatch==50) {
cProne.SayBackground("How about now?");
 }

  if (cloudwatch==200) {
cProne2.SayBackground ("It's a ufo");
  }
if (cloudwatch==350) {
cProne.SayBackground ("No... it's a soup bowl");
}
if (cloudwatch==550) {
  cProne2.SayBackground ("No it isn't");
//cProne2.SayBackground ("Now it's a microwave");
}

    if (cloudwatch==850) {
//cProne.SayBackground("No... I don't see it");
 }


}

else if (cloudcount==6) {   



  
  
    if (cloudwatch==100) {
cProne.SayBackground("Hmm...");
 }

  if (cloudwatch==200) {
cProne.SayBackground ("The sky is empty today");
  }
if (cloudwatch==500) {
cProne2.SayBackground ("A big blue sky");
}



}



     }
                            

  
}




