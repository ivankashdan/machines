  cRQ.Say("HOW DARE YOU!");
  cRQ.Say("HOW DARE YOU!");
  
  
    SecondChance=1;
   
    cMap.ChangeRoom(30);
}

else {


Wait(20);
cBlack.ChangeRoom(11);
  FadeIn(2);
  



  
    Wait(30);
  cRQ.Say("WHAT IS THE MEANING OF THIS INTERRUPTION!");
  Wait(20);
  //cHoseSpeech.Say("I'm ssorry, my lordz");
  cHoseSpeech.Say("I'm ssorry, my liege and liegesses...");
  cHoseSpeech.Say("Your graciousnessez I've just come back from the site");
   cHoseSpeech.Say("It haz taken a terrible turn");
   
   cHoseSpeech.Say("I have taken thiz entity under citizen'z arrest");
   cHoseSpeech.Say("And brought him to face judgement");
   cHoseSpeech.Say("Oh highnessez of many faces");
   //cHoseSpeech.Say("Oh masterzz of many faces");
   
   Wait(50);
   
    cRQ.Say("THE EXCUSE IS ACCEPTABLE!");
    cRQ.Say("ASSSESSMENT UNDERWAY...");
     Wait(50);
    cRQ.Say("THIS ENTITY IS NORMALLY BENEVOLENT");
    cRQ.Say("WHILE IT WORKS WITH DECAY, IT TILLS THE SOIL TO ESTABLISH SOMETHING NEW");
    cRQ.Say("IT WAS MADE TO SEEK OUT THOSE STUBBORN SOULS WHOSE DEPARTURE IS OVERDUE");
    cRQ.Say("TO HELP THEM ON THEIR WAY");
      Wait(30);
       cRQ.Say("SOMETHING HAS GONE WRONG");
       Wait(40);
    cRQ.Say("EMPTY YOUR POCKETS.");
    
    if (ORfound==1) {
      ofOR.ChangeRoom(20);
      aORfalls.Play();
    }
    
   
     if (Dfound==1) {
      ofD.ChangeRoom(20);
      aDfalls.Play();
    }
     if (HBfound==1) {
      ofHB.ChangeRoom(20);
      aHBfalls.Play();
    }
