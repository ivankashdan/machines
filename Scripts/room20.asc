      ofPN.ChangeRoom(20);
      aPfalls.Play();
    }
     if (Sfound==1) {
      ofS.ChangeRoom(20);
      aSfalls.Play();
    }
     if (PPfound==1) {
      ofPP.ChangeRoom(20);
 
    }
     if (Tfound==1) {
      ofT.ChangeRoom(20);
      aTfalls.Play();
    }
 Wait(50);
    cRQ.Say("DELINQUENT ENTITIES ARE NOT AUTHORIZED TO CARRY MATERIAL POSSESSIONS");
    cRQ.Say("THESE OBJECTS WILL BE CONFISCATED.");
    //cRQ.Say("THESE OBJECTS WILL BE CONFISCATED FOR THE DURATION OF THE TRIAL");
    Wait(20);
    Refresh();
     Wait(50);
     cRQ.Say("UNDER WHAT SUSPICION WAS THE SUSPECT BROUGHT TO TRIAL?");
     
     Wait(20);
     cHoseSpeech.Say("Welll... *ahem* your imperial majestieszz");
     
     cRQ.Say("SILENCE!");
     cRQ.Say("THE QUESTION WAS RHETORICAL. THE RED QUEUE SEES ALL");
     Wait(100);
     
     if (HBfound==1) {
     
     cRQ.Say("WE WATCHED AS THE LAST EMBER WAS PLUCKED FROM THE HEARTH OF THE OLD FORGE");
     cRQ.Say("LEAVING THE CUSTODIAN TO ENTER ENDLESS NIGHT");
     Wait(50);
     justactions++;
     }
     
      if (WorldTreeDead==1) {
     cRQ.Say("WE WATCHED AS AN ANIMAL OUT OF THE PAST WAS BROUGHT BEFORE ONE CLINGING ON");
     cRQ.Say("TO ENABLE THEM TO LET GO");
     Wait(50);
      justactions++;
     
     //cRQ.Say("WHO COULD FINALLY LET GO AFTER EVERYTHING THEY HAVE LOST");
      }
      
      if (PNfound==1) {
        cRQ.Say("WE WATCHED AS A SACRED RELIC WAS PLUCKED, THE QUINTESSENCE OF A SOUL FROM A CORPSE"); 
        cRQ.Say("BUT IT WAS OFFERED FREELY - ON THE LAST WISHES OF ONE WHO KNEW HER TIME HAD COME");
        cRQ.Say("IT WAS INTENDED FOR THE SUSPECT TO USE TO BRING ABOUT BALANCE");
        Wait(50);
         justactions++;
        
        
      }
     
    
    if (justactions==1) {
      
      cRQ.Say("THIS ACTION WAS CONSIDERED JUST.");
    }
    else if (justactions>1) {
    
    cRQ.Say("THESE ACTIONS WERE CONSIDERED JUST.");
    //cRQ.Say("THESE WERE JUDGED AS WORTHY ACTIONS");
    }
    
    Wait(100); 
    cRQ.Say("WE WATCHED AS AN OLD MAN WITH A DRINKING PROBLEM WAS WOKEN FROM FITFUL SLUMBERS");
    cRQ.Say("AND PERSUADED TO GO ANOTHER ROUND.");
    cRQ.Say("FULL IN THE KNOWLEDGE THAT HE WOULD NOT BE ABLE TO REFUSE");
     Wait(50); 
     cRQ.Say("SHAME ON YOU!");
     Wait(100);
     aRed_queue_music2.Stop();
     
     cRQ.Say("THE SUSPECT IS DECLARED GUILTY OF MANSLAUGHTER");
     Wait(50);
     
     //aTerrain_loop3.Play();
   // cRQ.Say("THE SUSPECT IS FOUND GUILTY OF THIS CAPITAL OFFENSE!");
