   Wait(50);
   cGuardianSpeech.Say("Sometimes, at night");
   cGuardianSpeech.Say("An aroma drifts up through the pavers");
   Wait(50);
   GuardianMoves=1;
   cGuardianSpeech.Say("That's why I'm so lively kid!");
   
   cGuardianSpeech.Say("That's my secret");
   GuardianMoves=0;
   
   hangaround=1;
   
    IdleHeld=1;
  IdleTimer=0;
  
 }

  

 
  else if ((returnfromalley==1)&&(Gremembered==0)&&(GEndCounter==0)&&(donttalk==0)) {
