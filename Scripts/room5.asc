    donttalk=0;
    
  }
   
   
   
  
   else if ((GEndCounter==0)&&(Theresmore==0)&&(GlobalTimer>24000)&&((ORfound==0)||(Tfound==0))&&(donttalk==0)) {     //Idle if you still don't have enough items after a bit
        
