function room_Load()
{
   IdleHeld=0;
  
  TimerInOneRoom=0;
  
   Place.SetView(241);
  Place.Animate(0, 5, eRepeat, eNoBlock, eForwards);
  
  
  
 //Gintro=1;                //temporary
 // WorldPommel=1;
  //GEndCounter=1;
    //Gdrunk=1;
 // onedrinktomany=1;

  //wokenup=1;
 // supplypump=1;
 // spikeizdrink=1;
  //WorldTreeDead=1;
 //Descended=1;
 //cocktail=1;
 //Water=1;
 
 
 
  
if (Gintro==0) {
cBlack.ChangeRoom(5);
donttalk=1;
}

  
  Refresh();
  

 
     cGuardian.SetIdleView(27, 0);
     hHotspot2.Enabled=true;
 
 



 if (cMap.PreviousRoom==12) {        //forge leave code
    
 lblAction.TextColor=0;
  lblAction.Font=eFontFont3;
  lblAction.Text="";
  
      SetAmbientTint(0, 0, 0, 0, 100);
  
if (Game.IsAudioPlaying(eAudioTypeMusic)) {
  Game.StopAudio(eAudioTypeMusic);
}

if (Game.IsAudioPlaying(eAudioTypeAmbientSound)) {
  Game.StopAudio(eAudioTypeAmbientSound);
}


if (Game.IsAudioPlaying(eAudioTypeSound)) {
  Game.StopAudio(eAudioTypeSound);
}
    
    
      // aCollapse1.Play();
       
       aORfalls.Play();
       aDfalls.Play();
       aSfalls.Play();
       
   ofOR.ChangeRoom(5);
   ofD.ChangeRoom(5);
   ofS.ChangeRoom(5);
   cMap.LoseInventory(iOR);
   cMap.LoseInventory(iSpiraly);
   cMap.LoseInventory(iDiamond);
   Collapsed=1;
    CollapsedRoom=1;
    
    Drinkready=0;
    
    
    
    //important item reset code
    
    Zfound=0;
PRfound=0;
LGfound=0;
cMap.LoseInventory(iZalron);
cMap.LoseInventory(iPR);
cMap.LoseInventory(iLG);

if (PPtemp==1) {
  PPfound=0;
  cMap.LoseInventory(iPP);
  PPtemp=0;
}

  if (PNtemp==1) {
    
    PNfound=0;
    cMap.LoseInventory(iPearl);
    PNtemp=0;
  }
  
  if (Ttemp==1) {
      
      Tfound=0;
      cMap.LoseInventory(iT);
      Ttemp=0;
    }

    
    
  }
  
  
  
  
if (cMap.PreviousRoom==16) {          //private party leave code
  
 alleycounter++; 
 
  SetAmbientTint(0, 0, 0, 0, 100);
  
if (Game.IsAudioPlaying(eAudioTypeMusic)) {
  Game.StopAudio(eAudioTypeMusic);
}

if (Game.IsAudioPlaying(eAudioTypeAmbientSound)) {
  Game.StopAudio(eAudioTypeAmbientSound);
}


if (Game.IsAudioPlaying(eAudioTypeSound)) {
  Game.StopAudio(eAudioTypeSound);
}

}
  
  







if ((GEndCounter==1)&&(onedrinktomany==1)) {
  
  cGuardian.SetIdleView(266, 0);
  
}
}








