    cGuardianSpeech.Say("Hey, kid. I'm feeling much better");
    GuardianMoves=0;
     Wait(50);
    cGuardianSpeech.Say("Up to drinking again, if you fancy one?");
    Wait(30);
    cGuardianSpeech.Say("I should be fine. But if I fall asleep again, let me lie in, kid...");
    
     cGuardianSpeech.Say("I need my beauty sleep.");
    

     
    Wait(30);
    GuardianMoves=1;
    cGuardianSpeech.Say("Your round, if I remember correctly");
    GuardianMoves=0;

    
    
    Feelingbetter=0;
    
     IdleHeld=1;
  IdleTimer=0;
    
  }
  
  
  else if ((WorldTreeDead==1)&&(Windstopped==0)&&(cMap.PreviousRoom==7)&&(GEndCounter==0)&&(donttalk==0)) {
 Wait(30);
 GuardianMoves=1;
  cGuardianSpeech.Say("That blasted wind stopped!");
  GuardianMoves=0;
  Wait(20);
  cGuardianSpeech.Say("Funny... I'd almost forgotten what it feels like to feel the sun on my skin");
  cGuardianSpeech.Say("Without the scathing cold");
  Wait(50);
  cGuardianSpeech.Say("Has spring arrived at last?");

    Windstopped=1;


 IdleHeld=1;
  IdleTimer=0;
  
}
  
  
  
   else if (( Awoken==1 )&&(hangaround==0)&&(cMap.PreviousRoom==7)&&(GEndCounter==0)&&(donttalk==0)) {
   Wait(30);
//Wait(50);
   cGuardianSpeech.Say("Hey kid, so I guess you've been wondering why I hang around here");
