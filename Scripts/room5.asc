{ 

  if (Gintro==0) {
    Label6.Visible=false;
    Wait(40);
    
    gGui2.Visible=true;
     
Mouse.Visible=false;
Label4.Text="Scant traces of life are left in the city. [Sometimes, an old machine seems to notice us. [[Or is this activity involuntary - murmurations of code, cut-off from their source, repeating themselves to no-one in particular...";
Gintro=1;
    
  }
  
  
      else if (Gintro==1) {
     Mouse.Visible=true;
     
  }
  
  
  
 
 if (gGui2.Visible==true) {
   
FadeIn(2);  
