function GuardianInteract() {
  
  
  
  IdleHeld=1;
  IdleTimer=0;
  
  Guardianclicked++;
  
    if ((Gdrunk==1)&&(onedrinktomany==0)) {
    
    aGuardianToll.Play();
    SaveGameSlot(2, "SecondChance");
    Feelingbetter=1;
    SleepTimer=0;
    SleepTimerStart=0;
    
    
    
     GuardianMoves=1;
     
    cGuardianSpeech.Say("*aarglch*");
    GuardianMoves=0;
    Wait(2);
    cGuardianSpeech.Say("Ahh...");
    Wait(10);
     GuardianMoves=1;
     cGuardianSpeech.Say("Who goes there!");
     GuardianMoves=0;
      Wait(30);
    cGuardianSpeech.Say("Oh, it's you kid");
    Wait(10);
    cGuardianSpeech.Say("I must have nodded off...");
    Wait(30);
    cGuardianSpeech.Say("Ughh... I don't feel so good. Too much to drink");
     Wait(10);
    cGuardianSpeech.Say("I better stop there for now");
     Wait(20);
     GuardianMoves=1;
     cGuardianSpeech.Say("Why don't you totter off and come back a little later?");
      GuardianMoves=0;
      Wait(2);
    //  cGuardianSpeech.Say("Gimme a chance to recover my... savoir-flair");
    // cGuardianSpeech.Say("I'll be right as rain next time later on");
    DrinkCounter=0;

    
    wokenup=1;
    Gdrunk=0;
    Rambling=0;
    GEndCounter=0;
    
  }
  
  
  
  else if ((Guardianclicked==10)&&(onedrinktomany==0)) {
    GuardianMoves=1;
    Wait(10);
    
    
    Speech.SkipStyle=eSkipTime;
    
    int tickletalk = Random(2); 
    
    if (tickletalk==0)  {
    cGuardianSpeech.Say("Stop! That tickles!");
    }
      else if (tickletalk==1)  {
    cGuardianSpeech.Say("Quit it, kid!");
    }
    
     else if (tickletalk==2)  {
    cGuardianSpeech.Say("Leave off!");
    }
  
    Speech.SkipStyle=eSkipMouseTime;
    
    GuardianMoves=0;
    Wait(20);
    Guardianclicked=0;
  }
  
  
  
  else if ((GEndCounter==1)&&(getoff==1)) {
    
    
    
    GuardianMoves=1;





cGuardianSpeech.Say("*bzz*");

if (buzzoff==0) {

GuardianMoves=0;
Wait(2);
    cGuardianSpeech.Say("Buzz off!");
    Wait(20);
    cGuardianSpeech.Say("I'm asleep... I'm asleep");
   buzzoff=1; 
  
  
  
}
    
    
  }
  

  
  else if (GEndCounter==0) {
  
  
  if (finished==0) {
    
     GuardianMoves=1;





cGuardianSpeech.Say("*aarglch*");


GuardianMoves=0;
    
    finished=1;
  }
  
  
    else if (finished==1) {
    
     GuardianMoves=1;





cGuardianSpeech.Say("*hrrpg*");
Wait(10);
GuardianMoves=0;
Speech.SkipStyle=eSkipTime;
  
cGuardianSpeech.Say("Hey... let me talk");

  Speech.SkipStyle=eSkipMouseTime;

    
    finished=2;
  }


else {
  
  GuardianMoves=1;





cGuardianSpeech.Say("*bzz*");


GuardianMoves=0;
}

}


  
}


