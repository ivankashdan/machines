   Wait(50);

   cGuardianSpeech.Say("Take a walk on the wild side");
  
   Wait(50);
   cGuardianSpeech.Say("I mean... don't get me wrong");
     cGuardianSpeech.Say("I see you've got your old familiars");

     cGuardianSpeech.Say("But you ought to try something new");
