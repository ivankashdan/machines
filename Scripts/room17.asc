// room script file



function room_Load()
{
  
  



cCitadelDies.SetIdleView(73, 0);
Wait(130);
cMap.Say("Darling?");
Wait(60);
cMap.Say("I'm home!");
Wait(20);
Dialogue4=1;
FirstScare=1;
WorldBottleFull=0;
cMap.ChangeRoom(30);


}


function hHotspot1_AnyClick()
{
  aWind_buzz_ambient.Stop();
aWind_buzz_cutout_ambient.Stop();
aGlass_breaks.Play();
cCitadelDies.LockView(73);
cCitadelDies.Animate(1, 10, eOnce);
//cGuardianSpeech.Say("Heh-heh...");
Wait(100);
cMap.ChangeRoom(15);
}



function hHotspot2_Interact()
{
  aWind_buzz_ambient.Stop();
aWind_buzz_cutout_ambient.Stop();
aGlass_breaks.Play();
cCitadelDies.LockView(73);
cCitadelDies.Animate(1, 10, eOnce);
//cGuardianSpeech.Say("Heh-heh...");
Wait(100);
cMap.ChangeRoom(15);

}

