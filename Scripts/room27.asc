function room_Load()
{
  

  Refresh();
     
  
 
  
cBlack.ChangeRoom(27);

  

}



function room_AfterFadeIn()
{ 

cBlack.ChangeRoom(11);
  FadeIn(10);
  
 
}




function repeatedly_execute_always()
{
 
  

   
  
  
  

 
   // ALL ACTION TEXT INVISIBLE  && hotspot disabled when Place is active
   
if ((cMap.ActiveInventory!=null)||(StageCounter!=0)) {

    if (Game.GetLocationName(mouse.x,  mouse.y) != null) {
    lblAction.Text="";
    hShrine.Enabled=false;
hBackwards.Enabled=false;

   }
   
   
   
   
}
else {  

hShrine.Enabled=true;
hBackwards.Enabled=true;

}
   
   
   
   
   
}
  
  



