      Wait(60);
      cForgeGirder.Say("I had heard in the capital");
      cForgeGirder.Say("That the new weapons are more subtle these days");
      Wait(100);
      cForgeGirder.Say("Let's see.");
    
      wisdom=2;
      FIdleCounter=0;
    }
    
    
      else if (wisdom==2) {
    
     cForgeGirder.Say("Perhaps. This time...");
      Wait(50);
    
    
    
    wisdom=3;
      }
    
    
    else if  (wisdom==3) {
      
