    }
     else {                                                   //if item held over anything else
       
       
        
        SetAmbientTint(255, 128, 0, 50, 50); 
       
     }
    }
      
     
      else{                                             //normal if nothing is held
      
      
     
     if (Outro==1) {
     
      SetAmbientTint(0, 0, 0, 0, 100);
     }
     else {
       
        SetAmbientTint(255, 128, 0, 50, 50); 
                              
     }
      
      
      
    }
  }
     
     

   #region//mouse hover icon
 
 
