      Wait(70);
     
      cForgeGirder.Say("Try something else...");
      cForgeGirder.Say("Less... experimental");
      Wait(30);
       aGirder_speaks2.Play();
      CollapseCounter=1;
      
      wisdom=4;
      return;
    }
    
    
    
    
  
  
  Forge=1;
  
   
    
    
  }
  
  

  }
 
 

  
  
  
  

  }





