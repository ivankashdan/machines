// room script file
int y = 0;

int Lighttouched=0;

int pancomplete=0;

function room_Load()
{
  //Water=1;   //temporary
  
  SetAmbientLightLevel(0);
  
  
  if (Water==1) {
    //aPianodrone.Play();
    //aWormikins.Play();
    aWormikinsfar.Play();
  }
  
  lblAction.TextColor=65535;
  aUnderground_ambient.Play();

if (pancomplete==0) {
Game.Camera.SetAt(0, y);
//cBlack.ChangeRoom(15);
//cBlack.Transparency=50;

}

if (pancomplete==1) {
  Game.Camera.SetAt(0, 200);
}
}


function room_AfterFadeIn()
{ 

if (pancomplete==0) {
Wait(40); 
FadeOut(20); 
//cBlack.ChangeRoom(11);
//Wait(100);
 

while (y < 200) {
  y ++;
Game.Camera.SetAt(0, y);
  Wait(1);
  
 //if (y==40) {FadeIn(10);}
 
 //if (y==50) {FadeOut(10);}
 
 if (y==100) {FadeIn(10);}
 
 if (y==140) {FadeOut(10);}
 
 if(y==150) {Wait(80);}
 
 if (y==200) {
   FadeIn(50);
   pancomplete=1;
 }
}
}



}

  
 



function hHotspot1_Interact()
{
//FadeOut(10);
//Wait(50);

cMap.ChangeRoom(25);

}

function room_Leave()
{
 y=0;
 
 
 
 Game.StopAudio(eAudioTypeMusic);
 
 
  lblAction.TextColor=0;
  lblAction.Text="";


SaveGameSlot(1, "Autosave");

}


function repeatedly_execute_always() 
{
  gInventoryBar.Visible=false;
  
  
  
   
  if ( Hotspot.GetAtScreenXY(mouse.x, mouse.y)== hHotspot1)
{
   Mouse.ChangeModeGraphic(eModeWalkto, 1804);
  //Mouse.ChangeModeView(eModeWalkto, 228);
 
  
}


 else if ( Hotspot.GetAtScreenXY(mouse.x, mouse.y)== hHotspot2)
{
   Mouse.ChangeModeGraphic(eModeWalkto, 1808);
  //Mouse.ChangeModeView(eModeWalkto, 228);
 
  
}

else {
  
   Mouse.ChangeModeGraphic(eModeWalkto, 2061);
  //Mouse.ChangeModeView(eModeWalkto, 226);
}
  
  
  
  
  if ((Hotspot.GetAtScreenXY(mouse.x, mouse.y) == hHotspot1) && (Lighttouched==0)){
  cDLight.SetIdleView(74, 0);
Lighttouched=1;
}
else if ((Hotspot.GetAtScreenXY(mouse.x, mouse.y) == hHotspot1) && (Lighttouched==1)){
}
else {cDLight.SetIdleView(74, 100);
  Lighttouched=0;
}
 
  
}

