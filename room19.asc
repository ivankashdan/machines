// room script file

int y = 0;
int RadishCounter=0;





function room_Load()
{
Screen.AutoSizeViewportOnRoomLoad=false;  
Screen.Viewport.SetPosition(0, 0, 427, 320);
//Screen.Viewport.Y=200;
//Screen.Viewport.Height=340;
Game.Camera.SetAt(0, y);
//Game.Camera.SetSize(320, 340);

cCitadel2.SetIdleView(150, 0);
hHotspot1.Enabled=true;
hHotspot2.Enabled=false;
}


function room_AfterFadeIn()
{ 
}


function hHotspot1_Interact()
{

cAnglePoise.Say("He is waiting for you...");
hHotspot1.Enabled=false;
hHotspot2.Enabled=true;

while (cCitadel2.y!=180) {
cCitadel2.y--;
Wait(1);
}


}





function room_RepExec()
{
  if (cMap.Room==19) {
  gInventoryBar.Visible=false;
  }
  
  
  if (RadishCounter==0) {
  SetBackgroundFrame(0);
}

 if (RadishCounter==1) {
  SetBackgroundFrame(1);
}





}



  
function on_key_press(eKeyCode keycode) {
 
  if (keycode == eKeyM) {
  cMap.ChangeRoom(12);
  }
}
  



function hHotspot1_AnyClick()
{

}

function room_Leave()
{
 
}




function hHotspot2_AnyClick()
{
cMap.ChangeRoom(25);
}

function hHotspot3_AnyClick()
{
RadishCounter=1;
SetBackgroundFrame(1);
cGlow.LockView(40);
cGlow.Animate(0, 5, eOnce);
cGlow.UnlockView();
cGlow.SetIdleView(41, 0);
cMap.AddInventory(iPR);

}

function hHotspot3_MouseMove()
{

}
