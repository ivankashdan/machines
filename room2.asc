function room_Load()
{
  
  
   IdleHeld=0;
  
    Refresh();
  
  Visited++;
  
  Place.Transparency=40;
 Place.SetView(240);
  Place.Animate(0, 5, eRepeat, eNoBlock, eForwards);

PlaceActive=0;                   //whirligig cancellations
whirliplaced=0;
hic=0;


  
  
  if (cMap.PreviousRoom==12) {        //forge leave code
    
 lblAction.TextColor=0;
  lblAction.Font=eFontFont3;
  lblAction.Text="";
  
      SetAmbientTint(0, 0, 0, 0, 100);
  
if (Game.IsAudioPlaying(eAudioTypeMusic)) {
  Game.StopAudio(eAudioTypeMusic);
}

if (Game.IsAudioPlaying(eAudioTypeAmbientSound)) {
  Game.StopAudio(eAudioTypeAmbientSound);
}


if (Game.IsAudioPlaying(eAudioTypeSound)) {
  Game.StopAudio(eAudioTypeSound);
}
    
    
      // aCollapse1.Play();
       aORfalls.Play();
       aDfalls.Play();
       aSfalls.Play();
       
   ofOR.ChangeRoom(2);
   ofD.ChangeRoom(2);
   ofS.ChangeRoom(2);
   cMap.LoseInventory(iOR);
   cMap.LoseInventory(iSpiraly);
   cMap.LoseInventory(iDiamond);
   Collapsed=1;
    CollapsedRoom=1;
    
    
    
    //important item reset code
    
    Zfound=0;
PRfound=0;
LGfound=0;
cMap.LoseInventory(iZalron);
cMap.LoseInventory(iPR);
cMap.LoseInventory(iLG);

if (PPtemp==1) {
  PPfound=0;
  cMap.LoseInventory(iPP);
  PPtemp=0;
}

  if (PNtemp==1) {
    
    PNfound=0;
    cMap.LoseInventory(iPearl);
    PNtemp=0;
  }
  
  if (Ttemp==1) {
      
      Tfound=0;
      cMap.LoseInventory(iT);
      Ttemp=0;
    }

    
    
  }
  
  
  
  
  
if (LFirstmeeting==0) {
 

  LEndCounter=1;
  
}
  
 


/*
//TapCounter2=1;                  //temporary
 Awoken=1;                  //temporary
RestartReminder2=2;                  //temporary
 LEndCounter=0;
  prophecy=1;
   Guessed=2;
//ForgeVisited=1;
//Descended=1;
 //Visited=5;
 Lintro=1;
 
 PPfound=1;

 */
 

//Room animations Invisible 
 
oS_D_Z_PN_GLOW.Transparency=100;
oS_D_Z_PN_GLOW.SetIdleView(142, 0);
//oOR_Sl_D_GLOW.Transparency=100; 
oOR_Sl_D_GLOW.SetIdleView(137, 0);
