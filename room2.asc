cLGOutline.Transparency=100;
rrPorcupine.Visible=false;
cLadyGhost.Transparency=100;
cResurrection.Transparency=100;
hLG.Enabled=false;
hHeart.Enabled=false;



  if (PPfound==0) {
  rrPorcupine.Visible=true;
  
  }
  
  PlaceActive=1;
  
 


  

       cLadyWinter.ChangeRoom(2);
       cLadyWinter.Baseline=1;
       cLadyWinter.SetIdleView(134, 0);
      cLadyWinter.Transparency=90;
      cDarknessPatch.Transparency=100;
      
      hCity.Enabled=false;
      
        
        
   


if (TapCounter2!=0) {
 aCricket_ambient.Play();
