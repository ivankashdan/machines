function hGLOW_Interact()
{

if (oOR_T_GLOW.Room==2) {


  Mouse.Visible=false;
  
  if (prophecy==1)  {
aPoof.Play();
  }
  
  Wait(20);
  silence=1;
  Game.StopAudio(eAudioTypeAmbientSound);
  Game.StopAudio(eAudioTypeMusic);
  aPortal_bowl.Stop();
  
  


if ((prophecy==0)&(TapCounter2==0)) {
  

cLady.Say("Wait...");
cLady.Say("Before you go");

  aMHLD_lady_prophecy2.Play();
  
Wait(50);
Wait(50);

cLady.Say("It is clear to me what your task is");
cLady.Say("It has been conferred to me, through my second sight");
cLady.Say("My gift of prophecy");
Wait(50);
Fortune=1;
Wait(50);
Wait(50);
cLady.Say("You will travel far from here, by the way of the sword");
Wait(50);
cLady.Say("You will sink deep into the unknown depths, from which the first roots sprung");
Wait(50);
cLady.Say("You will learn from those old souls");
cLady.Say("To teach the young");
cLady.Say("When spring comes again");

Fortune=0;
Wait(50);
Wait(50);

Wait(50);
cLady.Say("Child...");
Wait(50);
cLady.Say("I bid you to be patient");
Wait(50);

cLady.Say("Will you not listen to the songs of the changed ones?");
cLady.Say("Though they are long and slow");
cLady.Say("Every song ends, eventually");

prophecy=1;

}



cMap.ChangeRoom(1);


FadeOut(50);
Wait(100);
silence=0;

}



else if (oOR_Sl_D_GLOW.Room==2) {
  
  
  Mouse.Visible=false;
  aPoof.Play();
  Wait(20);
  silence=1;
  Game.StopAudio(eAudioTypeAmbientSound);
  Game.StopAudio(eAudioTypeMusic);
  aPortal_bowl.Stop();
 
  



 if (WorldPommel==0) {

cMap.ChangeRoom(12);
}


FadeOut(50);
Wait(100);
silence=0;
  
  
}





