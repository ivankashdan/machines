function room_AfterFadeIn()
{ 




    if (Lintro==0) {
      Mouse.Visible=false;
      Label6.Visible=false;
  Wait(50);
  FadeIn(3);
  
  gGui2.Visible=true;
Label4.Text="The old forest was lost centuries ago in a feast for the machines of industry that left few survivors. [[But underground the old root networks live on. [Many stories are hidden down there for those who know how to read them.";

//Label4.Text="A metal barrel-like structure with a torn up base lies on its back, beside a fallen tree. [There is a small hole in its face, and it is dark - apparently hollow inside.";
Lintro=1;

  }
  
    else if (Lintro==1) {
     Mouse.Visible=true;
  }
  
  cBlack.ChangeRoom(11);
  
    if (gGui2.Visible==true) {
FadeIn(3);  
  }

  
    if (cMap.PreviousRoom==1) {                              //turn on when the room is ready
                                                           //for divination stick here as a starter
                                                           
ofOR.ChangeRoom(2);
ofT.ChangeRoom(2);
//aCollapse1.Play();
cMap.LoseInventory(iOR);
cMap.LoseInventory(iT);
CollapsedRoom=1;
Collapsed=1;
  }
  
  
  
  if ((ForgeVisited==1)&&(Descended==1)) {
    
    prophecy=2;
    
  }
  
  
  if ((Visited==2)&&(LEndCounter==0)) {
   
    Wait(50);
    Wait(50);
 cLady.Say("Children... welcome back");
   Wait(50);
   cLady.Say("There is beauty in everything");
      cLady.Say("And what means little to one elder");
      cLady.Say("Can mean the world to another");
      

  
  
}

  else if ((Visited==3)&&(LEndCounter==0)) {
   
    Wait(50);
 cLady.Say("Welcome back, children");
   Wait(50);
   Wait(50);
   cLady.Say("I was thinking about the past...");
       cLady.Say("I know not how I arrived");
  cLady.Say("The city was full of noise, the boom of industry");
  cLady.Say("Before I awoke in this stillness");
  Wait(50);

      

  
  
}

 else if ((Visited==4)&&(LEndCounter==0)) {
       Wait(50);
 cLady.Say("Welcome back, children");
 cLady.Say("I was just thinking about you");

 }

else if ((Visited==5)&&(LEndCounter==0)) {

 Wait(50);
    Wait(50);
  cLady.Say("I can do little to help the trees here");
  cLady.Say("My body is a shell with no substance to it");
  cLady.Say("But I have learnt to listen to their long, slow stories...");
Wait(50);
cLady.Say("Inside me the stories accumulated");
cLady.Say("One day, into a voice");
   Wait(50);
  cLady.Say("Where perhaps a voice was needed, after all");



}

 else if ((Visited==6)&&(LEndCounter==0)) {
    Wait(50);
     cLady.Say("Oh, what a pleasant surprise");
   
cLady.Say("You are always welcome here, children");

 }
 
 
else if ((Visited==7)&&(LEndCounter==0)) {
 Wait(50);
    Wait(50);
 cLady.Say("Children... welcome back");
   Wait(50);
   
cLady.Say("Please allow me to apologize");
cLady.Say("I was rude when you first arrived");
cLady.Say("But long have I spoken, weaving the threads of fickle prophecy");
cLady.Say("And I must admit -");
cLady.Say("I thought my time had come.");
Wait(50);
cLady.Say("Please forgive an old lady her misgivings");
Wait(50);
cLady.Say("Now, what can I help you with?");
//cLady.Say("Of course, there is still plenty of work to be done");

}

else if ((Visited==8)&&(LEndCounter==0)) {
  Wait(50);
  Wait(50);
  Wait(50);
  cLady.Say("Oh. Hello children");
  cLady.Say("You caught me unawares");
}
  



else if ((Visited==9)&&(LEndCounter==0)) {
   Wait(50);
    Wait(50);
 cLady.Say("Children...");
 Wait(50);
cLady.Say("I have had nightmares recently");
cLady.Say("Of the machine returning to this twilight zone");


cLady.Say("I hope it was just a dream.");
//cLady.Say("I hope I am wrong");
 Wait(50);
 cLady.Say("If it returns... I will speak to the machine that made me");
 cLady.Say("I will tell it to stop, using my own voice");
 cLady.Say("I hope it will listen");

}



else if ((Visited==10)&&(LEndCounter==0)) {

 Wait(50);
    Wait(50);
 cLady.Say("Children...");
  Wait(50);
   Wait(50);
    cLady.Say("I grow tired. Forgive me if I have grown quiet");
    cLady.Say("The moon must be waning again...");

}
}




function repeatedly_execute_always()        ///some layers control
{
  
  if ((oOR_T_GLOW.Room==2)||(oOR_Sl_D_GLOW.Room==2)) {
  
  
  hGLOW.Enabled=true;
  cLady.Clickable=false;
  rrPorcupine.Clickable=false;
  
}
else {
  
  hGLOW.Enabled=false;
   cLady.Clickable=true;
   rrPorcupine.Clickable=true;
  
  
}
  
  
  
  lblAction.TextColor=65535;
  
  
    TimerL++;
    
    if ((gGui2.Visible==true)&&(TimerL>300)) {
 
 Label6.Visible=true;
 }
   
   
   
   


  if (cMap.ActiveInventory!=null) {  //MAKE OBJECTS GLOW BLUE BEFORE COMBINING
    if ((Character.GetAtScreenXY(mouse.x, mouse.y)== ofPN) ||        //if item held and hovering over fallen item
    (Character.GetAtScreenXY(mouse.x, mouse.y)==  ofS) ||
    (Character.GetAtScreenXY(mouse.x, mouse.y)== ofT) ||
    (Character.GetAtScreenXY(mouse.x, mouse.y)== ofOR) ||
    (Character.GetAtScreenXY(mouse.x, mouse.y)== ofPR) ||
    (Character.GetAtScreenXY(mouse.x, mouse.y)== ofZ) ||
    (Character.GetAtScreenXY(mouse.x, mouse.y)== ofPP) ||
    (Character.GetAtScreenXY(mouse.x, mouse.y)== ofPP_S) ||
    (Character.GetAtScreenXY(mouse.x, mouse.y)== ofLG) ||
    (Character.GetAtScreenXY(mouse.x, mouse.y)== ofD) ||
    (Character.GetAtScreenXY(mouse.x, mouse.y)== ofHB)||
        (Character.GetAtScreenXY(mouse.x, mouse.y)== ofS_OR) ||
    (Character.GetAtScreenXY(mouse.x, mouse.y)== ofS_OR_PN) ||

    
    
    (Character.GetAtScreenXY(mouse.x, mouse.y)== cLady))
    {
             
      SetAmbientTint(0, 0, 0, 100, 80);
      
    }
    
    
 
    
    else if (Character.GetAtScreenXY(mouse.x, mouse.y))        //if item held over character
    {
      
      SetAmbientTint(0, 0, 0, 100, 70);
      
    }
      
    else if (Object.GetAtScreenXY(mouse.x, mouse.y))         //if item held over object (doubled up)
     {
       
      SetAmbientTint(0, 0, 0, 100, 70);
    }
     else {                                                   //if item held over anything else
       
       SetAmbientTint(0, 0, 0, 100, 80);  
     }
    }
      
     
      else{                                             //normal if nothing is held
      
      SetAmbientTint(0, 0, 0, 100, 80);                         
      
      
    }
    
    
    
   
    
    
    
    
    if (Fortune==1) {
      cLadySpotlight.Transparency=0;
   
       
      if (Bowlplaying==0) {
        //Game.SetAudioTypeVolume(eAudioTypeAmbientSound, 40, eVolChangeExisting);
        aPortal_bowl.Play();
        Bowlplaying=1;
        Awake+=1;
      }
      
    }
    
    else if (Fortune==0) {
      cLadySpotlight.Transparency=100;
      
      if (PNfound==0) {
        aPortal_bowl.Stop();
      }
        //Game.SetAudioTypeVolume(eAudioTypeAmbientSound, 50, eVolChangeExisting);
        Bowlplaying=0;
        
      
      
      
    }
    
    
    
    #region//mouse point hovers
      if(hHeart.Enabled==true) {
     lblAction.Text="";
     if (Hotspot.GetAtScreenXY(mouse.x, mouse.y)== hHeart) {
       Mouse.ChangeModeGraphic(eModeWalkto, 1805);
   }
   else {
     Mouse.ChangeModeGraphic(eModeWalkto, 2061);
   }}
     
     
     
  else if(hHeart.Enabled==false) {
   
 if (cLady.Speaking==true) {
    
    lblAction.Text="";
  }
 
 
  else if (Character.GetAtScreenXY(mouse.x, mouse.y)== cLady) {
  
  
     if ((TapCounter2!=0)&&(PNfound==0)) {
       Mouse.ChangeModeGraphic(eModeWalkto, 1805);
  }
  
  else if ((Awoken==1)&&(PNfound==0)) {
    Mouse.ChangeModeGraphic(eModeWalkto, 1806);
  
  }
  
  
  else {
    Mouse.ChangeModeGraphic(eModeWalkto, 1808);
  }
}

else if (Button.GetAtScreenXY(mouse.x, mouse.y) == btnInvDown) {
  
  lblAction.Text="Take all";
}

else if (( Object.GetAtScreenXY(mouse.x, mouse.y)== rrPorcupine)&&(gInventoryBar.Visible==false)) 
{
  Mouse.ChangeModeGraphic(eModeWalkto, 1805);
}




else if (( Hotspot.GetAtScreenXY(mouse.x, mouse.y)== hFallenTree)&&(gInventoryBar.Visible==false)) 
{
 Mouse.ChangeModeGraphic(eModeWalkto, 1808);
 
}

else if ( Hotspot.GetAtScreenXY(mouse.x, mouse.y)== hBranch)
{
  Mouse.ChangeModeGraphic(eModeWalkto, 1808);
}



else if  ( Hotspot.GetAtScreenXY(mouse.x, mouse.y)== hHotspot14)
{
  Mouse.ChangeModeGraphic(eModeWalkto, 1808);
  
}

else if  ( Hotspot.GetAtScreenXY(mouse.x, mouse.y)== hHotspot15)
{
  Mouse.ChangeModeGraphic(eModeWalkto, 1808);
  
}






else if ( Character.GetAtScreenXY(mouse.x, mouse.y)== oOR_T_GLOW)

{
  Mouse.ChangeModeGraphic(eModeWalkto, 2082);
}


 else if (Character.GetAtScreenXY(mouse.x, mouse.y)== oOR_Sl_D_GLOW) {
   
   

   Mouse.ChangeModeGraphic(eModeWalkto, 2081);
   
 }
 
 
 
 
 else if (Hotspot.GetAtScreenXY(mouse.x, mouse.y)== hGLOW) {
   
   
   
   if (oOR_T_GLOW.Room==2) {
     
     Mouse.ChangeModeGraphic(eModeWalkto, 2082);
   }
   else if (oOR_Sl_D_GLOW.Room==2) {
     
      Mouse.ChangeModeGraphic(eModeWalkto, 2081);
   }
   
   
   
 }
 

else if ( Hotspot.GetAtScreenXY(mouse.x, mouse.y)== hPlace )
{
  
}
 
 
  else if (gInventoryBar.Visible==false)
{
  
  
  
  
     if ( Object.GetAtScreenXY(mouse.x, mouse.y))
{
  lblAction.Text="";
   Mouse.ChangeModeGraphic(eModeWalkto, 1805);
}
     else if ( Character.GetAtScreenXY(mouse.x, mouse.y))
{
   lblAction.Text="";
   Mouse.ChangeModeGraphic(eModeWalkto, 1805);
}

else if  ( Hotspot.GetAtScreenXY(mouse.x, mouse.y)== hRoots)
{
  
  Mouse.ChangeModeGraphic(eModeWalkto, 1808);
  
}


 else {
  lblAction.Text="";
  
 Mouse.ChangeModeGraphic(eModeWalkto, 2061);
 }
 
}
 
 
 


 

     }
     
    
    
    #endregion 
     
    
    
     //some layers
   
   Place.Baseline=10;
    cDarknessPatch.Baseline=2;
    
    cBlack.Baseline=150;
    
   rrPorcupine.Baseline=3;
   oOR_Sl_D_GLOW.Baseline=100;
   oOR_T_GLOW.Baseline=100;
   
    

    
}


function room_RepExec()
{
  
  

    if (IdleTimer>100) {
    
    IdleHeld=0;
    IdleTimer=0;
  }
  
  
    if (IdleHeld==1) {
    IdleTimer++;
      
    }

  
  
  
  
  else if ((StageCounter==0)&&(LEndCounter==0)&&(PNfound==0)) {            //idle dialogue
IdleCounter+=1;

  
  if (IdleCounter==500) {
//cLady.SayBackground("One at a time, please");
cLady.SayBackground("Come now, children");
  }
  
  
  
  if (IdleCounter==800) {

cLady.SayBackground("Don't be shy");
  }
  


 if (IdleCounter==1400) {

cLady.SayBackground("Step forward, I will read your fortunes");
  }
  
 

if (IdleCounter==2000) {
  //IdleCounter=0;


}

  }


  
  

}


function room_Leave()
{
  
  
  
lblAction.TextColor=0;
  lblAction.Text="";






SaveGameSlot(1, "Autosave");

}


