function room_RepExec()
{
  
  
      if (IdleTimer>100) {
    
    IdleHeld=0;
    IdleTimer=0;
  }
  
  
    if (IdleHeld==1) {
    IdleTimer++;
      
    }

  
  
  
  else if ((Water==1)&&(gGui2.Visible==false)) {
    Rambling+=1;
  
  if (StageCounter==0) {
  
  if (Rambling==200) {
cTap.SayBackground("Welcome. Welcome!");
 }
 if (Rambling==700) {
cTap.SayBackground("There is plenty for everyone!");
 }

if (Rambling==1000) {
  Rambling=0;
}
    
    
  }
  }
  

 else if ((TapLight==0)&&(gGui2.Visible==false)) {
  Rambling+=1;
  
  if (StageCounter==0) {
  
  if (Rambling==200) {
cTap.SayBackground("What a waste...");
 }
 if (Rambling==700) {
cTap.SayBackground("And it was all going so swimmingly...");
 }
  if (Rambling==1300) {
cTap.SayBackground("Nobody thinks of the water bill...");
  }
  if (Rambling==1600) {
cTap.SayBackground("I told them this day was coming...");
  }
if (Rambling==2200) {
cTap.SayBackground("They've taken every last drop...");
}
if (Rambling==2400) {
cTap.SayBackground("Bloody parasites");
}
if (Rambling==2900) {
cTap.SayBackground("Where is that damn plumber?");
}
if (Rambling==3300) {
  Rambling=0;
}
  }
  
  else if (TapCounter2==0) {
     
     Ramblingdark+=1;
     
  if (Ramblingdark==200) {
cTap.SayBackground("Who goes there?");
 }
 if (Ramblingdark==700) {
cTap.SayBackground("I can't see a bloody thing...");
 }

if (Ramblingdark==1600) {
cTap.SayBackground("There's not enough light in here...");
}

  if (Ramblingdark==2400) {
cTap.SayBackground("Show yourself!");
  }
  

if (Ramblingdark==3000) {
 
  Ramblingdark=0;
}
    
  }
  
  
  
  else {
     Ramblingdark+=1;
      
  if (Ramblingdark==300) {

//cTap.SayBackground("You're not very good at listening are you?");
 }
 if (Ramblingdark==700) {
cTap.SayBackground("Leave this place...");
 }

if (Ramblingdark==900) {
cTap.SayBackground("And never come back.");
}

 if ((Ramblingdark==1200)&&(PNfound==0)) {
   //cTap.SayBackground("Go speak to your precious Lady");
//cTap.SayBackground("Nothing kind to your ears...");
 }


if (Ramblingdark==1500) {
cTap.SayBackground("I will say no more...");
 }
 

  
    if (Ramblingdark==2000) {
 Ramblingdark=0;
  }
    
  }
}
}




function room_Leave()
{




  lblAction.TextColor=0;
  lblAction.Text="";
  gInventoryBar.Visible=false;
lblAction.Visible=true;




SaveGameSlot(1, "Autosave");
}
  





function oPP_S_Interact()
{


Mouse.Visible=false;
  aPoof.Play();
  Wait(20);
  silence=1;
  Game.StopAudio(eAudioTypeAmbientSound);
  Game.StopAudio(eAudioTypeMusic);
  //aPortal_bowl.Stop();
 
cMap.ChangeRoom(16);

FadeOut(50);
Wait(100);
silence=0;



}

