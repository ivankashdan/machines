// room script file

int TimerT;

function room_FirstLoad()
{
  gGui2.Visible=true;
Mouse.Visible=false;
Label4.Text="Under the ground is a lake fed by countless tributaries. The first settlers chose to build their homes above.[[Their descendents did not know where the water came from, but continued to drink nevertheless, assuming the supply to be endless...";
//[[But now the pipes are clogged with muck, nothing will run in or out, and tempers have sunk to an all-time low.";
//Label4.Text="The pump room generated an endless supply of water for the city above. [[When the water stopped, the people in the city were thirsty for the first time in their lives. And no-one knew how to get more...";
//Label4.Text="A faucet is silhouetted in the dark above a basin, with a rag wrapped around its neck. Two temperature control knobs stands beside the tap like whispering advisors.[A waning light comes up from within the basin, offering the three figures grim highlights to their countenance.";

}




function room_Load()
{
  
  
   IdleHeld=0;
  
   Place.SetView(242);
  Place.Animate(0, 5, eRepeat, eNoBlock, eBackwards);
  
  
  //Water=1;          //temporary
  //TapCounter2=1;     //temporary


lblAction.TextColor=65535;
Rambling=0;

  Refresh();


cThroneRoom.SetIdleView(151, 0);

if (Water==0) {
  cThroneRoom.Transparency=10;

if (Game.IsAudioPlaying(eAudioTypeAmbientSound)==false) {
  
  aUnderground_ambient.Play();
}

}


else if (Water==1) {
  cThroneRoom.Transparency=100;
  cRunningWater.ChangeRoom(25);
  cRunningWater.SetIdleView(235, 0);
  
  
  //aFiresconce.Play();
  aRunningwater2.Play();
  
  //aTerrain_key_loop.Play();
  //aTap_end.Play();
  aMHLD_tap_final.Play();
  //aSpider_loop4.Play();

  
}




}



function room_AfterFadeIn()
{ 
Label6.Visible=false;




    if ((fixthewaterproblem==1)&&(Water==1)) {
          int i = 0;
 while (i < ObjectivesList.ItemCount) // search from first to last item
 {
    if (ObjectivesList.Items[i] == "Fix the water problem")
    {
       // found it!
       ObjectivesList.RemoveItem(i); // remove this item
       i = ObjectivesList.ItemCount; // a trick to end the loop right away
    }
    i++; // next item...
}
      CompletedList.InsertItemAt(0,"Fix the water problem");
      fixthewaterproblem=2;
   }
  
 
}




