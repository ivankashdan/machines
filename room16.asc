function oPP_S_Interact()
{
  
  if (Descended==0) {
  FadeOut(1);
  Wait(100);
cMap.ChangeRoom(15);
Descended=1;

if (findawaydown==1) {
          int i = 0;
 while (i < ObjectivesList.ItemCount) // search from first to last item
 {
    if (ObjectivesList.Items[i] == "Find the reservoir")
    {
       // found it!
       ObjectivesList.RemoveItem(i); // remove this item
       i = ObjectivesList.ItemCount; // a trick to end the loop right away
    }
    i++; // next item...
}
      CompletedList.InsertItemAt(0,"Find the reservoir");
   }


  }
//FadeIn(1);
else {
  
  FadeOut(20);
  Wait(50);
  cMap.ChangeRoom(15);
}


