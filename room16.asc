function room_Leave()
{
  
  lblAction.TextColor=0;
  lblAction.Text="";
  
  

PrisonBreak=0;
  PlaceActive=0;
  
  
  if (PrisonBreak==1) {
    
    HoopsTalk=0;
  }

if (onedrinktomany==0) {

  SaveGameSlot(1, "Autosave");
}

}



  
