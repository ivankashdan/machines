  if (cMap.Room==12) {
    
 
  
    
    aRqdrum2.Play();
        Game.StopAudio(eAudioTypeAmbientSound);
    aMap_wind.Play();
  
    
         cForgeGirder.Say("Yes...");
    
    cForgeGirder.Say("The sword is the only way out of here");
 
       Wait(120);
       
       
       cForgeGirder.Say("So you have not come to release me...");
       Wait(50);
    cForgeGirder.Say("Then perhaps - the war isn't over...");
    Wait(50);
    
    
    
    Wait(120);
     cForgeGirder.Say("But the day is late");

     Wait(50);
     
     
     cForgeGirder.Say("While we have talked, the fires have grown so low");
     Wait(50);
      cForgeGirder.Say("It is almost like the days of old...");
     Wait(100);
       cForgeGirder.Say("I cannot remember... the last time I let it falter so");
       
       Wait(50);
   
   
 
   
   Wait(20);

       cBlack.Transparency=100;
        cBlack.ChangeRoom(12);
          int trans = cBlack.Transparency;
      
      while (trans > 0) {
    trans--;
    cBlack.Transparency = trans;
   
    Wait(1);
  }

   
       Wait(100);
        cForgeGirder.Say("My hands... are covered in blood");
        Wait(50);
        cForgeGirder.Say("And in the dark. I can see them");
        Wait(50);
        cForgeGirder.Say("All of them.");
      
        Wait(50);

        cForgeGirder.Say("Countless unknown faces");
        cForgeGirder.Say("Who felt strong bearing my arms");
       cForgeGirder.Say("Cut down in the next moment...");
        Wait(30);
        Wait(30);
        cForgeGirder.Say("How pointless");
        Wait(30);
        cForgeGirder.Say("The weight... is too great to bear");
        
      Wait(150);
      
       cForgeGirder.Say("There was a time, when the dark summoned up... other possibilities");
    
       cForgeGirder.Say("Countless innovations and ideas...");
     Wait(100); 
      
     cForgeGirder.Say("This much you have shown me");  
       
         Wait(100);
         
         cForgeGirder.Say("So I am ready as I possibly can be");
         cForgeGirder.Say("To face the dark again...");
         
         
       Wait(100);
      
      
      
       WorldPommel=1;
   workshopstock=0;
    
    
            int i = 0;
 while (i < ObjectivesList.ItemCount) // search from first to last item
 {
    if (ObjectivesList.Items[i] == "Build instruments of war")
    {
       // found it!
       ObjectivesList.RemoveItem(i); // remove this item
       i = ObjectivesList.ItemCount; // a trick to end the loop right away
    }
    i++; // next item...
}
      CompletedList.InsertItemAt(0,"Build instruments of war");
   
    
    
    
              int ii = 0;
 while (ii < CompletedList.ItemCount) // search from first to last item
 {
    if (CompletedList.Items[ii] == "7/7 items have been found")
    {
       // found it!
       CompletedList.RemoveItem(ii); // remove this item
       ii = CompletedList.ItemCount; // a trick to end the loop right away
    }
    ii++; // next item...
}
      
    
  }
  
  
  if (cMap.Room!=12) {
  
  aPoof.Play();
  
  }
  
  Wait(20);
  silence=1;
  Game.StopAudio(eAudioTypeAmbientSound);
  Game.StopAudio(eAudioTypeMusic);
  aPortal_bowl.Stop();
 
  
if (cMap.Room==12) {
  
  if (cMap.PreviousRoom==5) {
