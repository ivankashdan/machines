function game_start() 
{
  
 // Speech.DisplayPostTimeMs=1000;   //normal delay
  Speech.DisplayPostTimeMs=3000;
  
  // register a GUI to use for the inventory bar
  TwoClickHandler.InventoryGUI = gInventoryBar;

  // register a Label to use for action text
  
  TwoClickHandler.ActionLabel = lblAction;

  // optionally set the popup distance for the inventory bar
  //TwoClickHandler.PopupProportional = 0.5;
  //TwoClickHandler.PopupDistance = 50;

  // optionally reverse the left and right mouse buttons
  //TwoClickHandler.ReversedClicks = true;
 
  
 //System.Windowed = !System.Windowed;
 
//OR_SCounter[5]=1;
//OR_SCounter[2]=1;  //temporary!!!!!
//OR_TCounter[1]=1;   //temporary!!!!!



}




function on_key_press(eKeyCode keycode) 
{
    if (keycode == eKeyF4) {                   //exit game instantly
    QuitGame(0);
    //cMap.ChangeRoom(cMap.PreviousRoom);
  }
  
  
  else if (keycode == eKeyTab) { //Windowed mode Shortcut
    System.Windowed = !System.Windowed;
  }


  else if (keycode == eKeySemiColon) {
    
    if (cMap.Room==1) {
    
    
   cMap.ChangeRoom(2);
    }
    
    else if (cMap.Room==2) {
    
    
   cMap.ChangeRoom(1);
    }
    
    
    
  }
  
  
  else if (keycode ==eKeyL)
  {
    
    workshopstock=0;
    
HBfound=1;
if (cMap.HasInventory(iHeliobrother)==false)
{cMap.AddInventory(iHeliobrother); 
