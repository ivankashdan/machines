    //Hoop interactions

function cHoopL_Interact()
{ 

IdleHeld=1;
  IdleTimer=0;




if (cMap.Room==6) {
  if (HoopCounter==1) {
  cHoopL.Say("Stand back...");
  cHoopL.Say("This is a restricted area.");
  HoopCounter=2;
  }
  else if (HoopCounter==2) {
  cHoopL.Say("This is a restricted area.");
  }
   //cHoopL.Say("Seen any bikes?");
  
}

if (cMap.Room==7) {

if (HoopCounter==0) {
  
  
  cHoopL.Say("Hello, friend");
  cHoopL.Say("Sorry to bother you...");
  Wait(20);
cHoopL.Say("Have you seen a bicycle?");
HoopCounter=1;
}

else if (HoopCounter==1) {
  
  cHoopL.Say("No? Oh, okay then");
  cHoopL.Say("Oh dear...");
  cHoopL.Say("What a shame");
  //cHoopL.Say("Perhaps it wandered off");
  
//cHoopL.Say("I can't find my bike");
//cHoopL.Say("Oh dear...");
//cHoopL.Say("I hope that bike rustler isn't at it again...");
HoopCounter=2;
}

else if (HoopCounter==2) {
  cHoopL.Say("I'm sure I left it right here...");
  cHoopL.Say("I hope it hasn't been stolen");
  //It couldn't possibly have been stolen, do you think?");
  //Wait(50);
  //cHoopL.Say("No, not in this day and age");
  HoopCounter=3;
}

else if (HoopCounter==3) {

cHoopL.Say("Have you seen a bicycle?");
//cHoopL.Say("I hope it hasn't been stolen");
//cHoopL.Say("I'm sure I left it right here...");

}







else if (WorldTutorial==1) {
if (World2==1) {

if (HoopCounter==0) {
  cHoopL.Say("Hi there");
  HoopCounter=10;
}
else if (HoopCounter==10) {
  cHoopL.Say("There used to be a lovely cycle route not far from here");
  cHoopL.Say("If you're new to town, you might want to check it out");
  cHoopL.Say("Go back to the station. Turn right");
  cHoopL.Say("A little track runs all the way out to sea");
  cHoopL.Say("if you follow it for long enough.");
  HoopCounter=11;
}
else if (HoopCounter==11) {
  cHoopL.Say("Ride well!");
  //HoopCounter=12;
}
}

else if ((HoopCounter==0) && (RiversideGiven==0)) {
cHoopL.Say("Seen any bikes?");
HoopCounter=1;
}

else if ((HoopCounter==1) && (RiversideGiven==0)) { 
cHoopL.Say("There used to be a lovely cycle route[ not far from here, close to the river...");
cHoopL.Say("Now that the winds have stopped,[ you might want to take a look.");
cHoopL.Say("Righty here knows the way...");
 //cHoopL.Say("I'll mark it on your map");
 //DisplayAtY(180, "Riverside added to Map");
 RiversideGiven=1;
 Stage4=1;
 hotspot[5].Enabled=true;
 //cHoopL.Name="Go to river";
}
else if ((HoopCounter==1) && (RiversideGiven==1)) {
  
  cHoopL.Say("Let him show you the way...");
  cHoopL.Say("(Gives him a sense of purpose)");
  
 //cHoopL.Say("Let me know if you see any bikes!");

}
}




}



}




    //Whirligig interactions

function cRoger_Interact()
{

  
  
  IdleHeld=1;
  IdleTimer=0;
  
  
  if (WorldTreeDead==0) {
    
  
  if ((fHBCounter==1)&&(ofHB.Room!=1)) {
    
    
    int HBblaze=Random(5);
  
  if (HBblaze==0) {
      cRoger.Say("What could I have done...");
    
  }
  else if (HBblaze==1) {
  cRoger.Say("There was nothing I could do...");
  }
  
  else if (HBblaze==2) {
  
    
  cRoger.Say("The animals... the trees...");
  }
  
  else if (HBblaze==3) {
  cRoger.Say("They're all gone...");
  }
  
  else if (HBblaze==4) {
    cRoger.Say("No-one else survived...");
  }
  
  else if (HBblaze==5) {
   cRoger.Say("It burns... it burns");
  }
    
  }
  
    
  else if (treeplanted!=0) {
    
    
    if (WhirliCounter2==0) {
    Wait(10);
    cRoger.Say("The tree we planted glows...");

    Wait(20);
    cRoger.Say("Perhaps it is something concerned with the history of this hilltop");
    cRoger.Say("Which is written in the soil");
    Wait(20);
    cRoger.Say("Whatever messages were left behind, whatever secrets and stories");
    cRoger.Say("Will be the sole privilege of a new tree to know"); 

     Wait(50);
    cRoger.Say("Alas, if only my body was blessed with roots...");
    

    WhirliCounter2=1;
    
  }
  
   else if (WhirliCounter2==1) {
     Wait(10);
     cRoger.Say("I had hoped... it would appear by now");
     cRoger.Say("My animal...");
     cRoger.Say("It still hasn't arrived...");
     cRoger.Say("I wonder where it could be?");
     
     
     aChime_strike2.Play();
  findcritter=1;
    ObjectivesList.InsertItemAt(0,"Find critter");
  
  addobjectivetimer=1;
     
     
  
     WhirliCounter2=2;
   }
   
   else if (WhirliCounter2==2) {
     
     cRoger.Say("Don't lose hope, my friend");
     cRoger.Say("We'll root the critter out sooner or later...");
     

     
     
   }
   else {
     
     
   }
   
   
  }
  
  
  
  
  
  else {
  
  if (WhirliCounter==0) {

cRoger.Say("Hello there, come to enjoy the breeze?");

WhirliCounter=1;
  }

  else if (WhirliCounter==1) {
   
    cRoger.Say("Nothing else up here but the wind");
cRoger.Say("But that's enough for some people");

WhirliCounter=2;
  }
  
    else if (WhirliCounter==2) {
     
      
      cRoger.Say("Still here are you?");
      cRoger.Say("Aye, it's a fine breeze indeed");

  
  

WhirliCounter=3;
  }
 
  
  
  
  
      else if (WhirliCounter==3) {
          cRoger.Say("A brisk upper wind!");





WhirliCounter=4;

  }



      else if (WhirliCounter==4) {
      
       
       cRoger.Say("Hmm...");
       cRoger.Say("I'm sorry to trouble you, friend");
       cRoger.Say("But you wouldn't happen to have seen a critter, would you?");
      cRoger.Say("Black fur, somewhat round, about yay high");
   
       cRoger.Say("On your way up the hill?");

       
       
 


WhirliCounter=5;
  }
  
  
        else if (WhirliCounter==5) {
   
   cRoger.Say ("No?");
   cRoger.Say ("Strange.");
   Wait(10);
   cRoger.Say ("I haven't been able to see one either");
   cRoger.Say ("Yet they were once quite numerous in this area");

   
   
   
 
  
  WhirliCounter=6;
  
  }
  
   else if (WhirliCounter==6) {
 // Wait(10);
 
 cRoger.Say ("Perhaps you can help me after all");
 cRoger.Say ("If there is nothing else keeping you?");
 cRoger.Say ("I've had an idea. About the critters");
 Wait(30);
 cRoger.Say ("I was thinking...");
 Wait(30);
 cRoger.Say ("No, it's a silly idea");

  
   WhirliCounter=7;
   }
   
   else if (WhirliCounter==7) {
  // Wait(10);
   cRoger.Say ("I was thinking of planting a tree");
   
   
           aChime_strike2.Play();
Wait(30);
gGui3.Visible=true;
aWhirligig3.Play();
Mouse.Visible=false;
Wait(100);
gGui3.Visible=false;

keepembusy=1;
whirlitask=1;
ObjectivesList.InsertItemAt(0,"Plant a tree");


   cRoger.Say ("This particular critter might [mistake it");
   
   cRoger.Say ("For the first signs of spring");
   cRoger.Say ("If indeed, it is hibernating");
  
  Mouse.Visible=true;

  

   
   WhirliCounter=8;
  } 
     else if (WhirliCounter==8) {

  
  cRoger.Say ("Well, no point stand around talking about it all day");
  cRoger.Say ("We best get to work");

  Wait(50);
  cRoger.Say ("Find me something living");
  cRoger.Say ("And something to prop it up");
  
 
   
   
   WhirliCounter=9;
  } 
     else if (WhirliCounter==9) {
       
       
  cRoger.Say ("The animal... is round, and covered in black fur");

  cRoger.Say ("It hibernates in winter, then reappears in spring");
  cRoger.Say ("I had hoped to plant a tree, to rouse it early from its slumbers");
  cRoger.Say ("To trick it into leaving the comfort of its home...");
  Wait(10);
  cRoger.Say ("If only... it saw something growing out here");

  
   
   
   WhirliCounter=10;
  } 
     else if (WhirliCounter==10) {
 
  cRoger.Say ("This hilltop was once a thriving woodland");
  cRoger.Say ("Plenty of shadows to hide in. Now there is only the ground");
  cRoger.Say ("Many now consider the animal I am looking for extinct.");
  Wait(20);
  cRoger.Say ("I would like to find evidence to the contrary");
   IdleCounter=1;

   
   WhirliCounter=11;
  } 
       else if (WhirliCounter==11) {
  
   cRoger.Say ("You heard me, friend");
   cRoger.Say ("Something living and something to prop it up");
   cRoger.Say ("If you're not too busy");

   
  
  } 
  
  
}
}
}




//Lady Interactions

function cLady_Interact()
{


IdleHeld=1;
  IdleTimer=0;
  
  

if ((TapCounter2!=0)&&(PNfound==0)) {
  
  //aTerrain_loop1.Play(eAudioPriorityNormal, eRepeat);
  //aLady_pearl.Play();
  aMHLD_lady_pearl.Play();
  
  //Fortune=1;
  cLadyGhost.Transparency=0;
  Refresh();
  cLadyGhost.LockView(145, eStopMoving);
  cLadyGhost.Animate(0, 5, eOnce);
  cLadyGhost.UnlockView();
  cLadyGhost.SetIdleView(146, 0);
  //cLadyGhost.Clickable=true;
  gInventoryBar.Clickable=false;
  gInventoryBar.Transparency=100;
  hotspot[11].Enabled=true;
  cLady.Clickable=false;
Mouse.ChangeModeGraphic(eModeWalkto, 2061);

  
}

else if (TapCounter2==0) {



  if ((OR_TCounter[2]==0)&&(Countenance==1)) {                     //OR_T dialogue
  cLady.Say("May I ask... how have you found me, child?");
}

  
else if ((PPCounter[2]==1)&&(wellline==0)) {                //PPS dialogue
  cLady.Say("If we can contain the dark");
  cLady.Say("it becomes ours... our very own");
}


else if ((HBCounter[2]==1)&&(OR_HBCounter[2]==0)&&(Descended==1)) {              //HB dialogue
  cLady.Say("The fire must be fed raw material");
  cLady.Say("It must stand tall to drive back the shadows");
  
}
  
 
 
 else if ((PPfound==0) &&(LEndCounter==0) && (prophecy==1)) {
    cLady.Say("There is a darkness that gathers at the head of this tree");
   // Wait(20);
    //cLady.Say("Making it... difficult to think");
    cLady.Say("Sometimes... I hear it talking it to me");
darkness=1;
  
}
 
  
 else if ((Guessed==1)&&(prophecy==1)) {
   
   if (Fullcircle==0) {
    Wait(50);
   }
    cLady.Say("Yes, it is clear to me now...");
     if (Fullcircle==0) {
    Wait(50);
     }
    cLady.Say("There are three in my living memory");
    cLady.Say("Elders who are out of reach, but who I remember when our roots were joined");
     if (Fullcircle==0) {
    Wait(50);
     }
    cLady.Say("I do not know what state you will find them in");
    cLady.Say("It could be as if time has not elapsed");
    cLady.Say("Or they may be... changed");
   
    threeelders=1;
    

     Guessed=2;

  }
  
    else if ((Guessed==2)&&(prophecy==1)) {
     
     if (ForgeVisited==1) {
        
        if (terriblechoice==0) {
       Wait(50);
        }
       cLady.Say("There once was a blacksmith who lived on the edge of a blade");
        
        if (terriblechoice==0) {
       Wait(70);
        }
        
      //  cLady.Say("He made a terrible choice.");
       //cLady.Say("He made a terrible choice. But his work... has punished him for it");
     // Wait(100);
      // cLady.SayBackground("But now he can rest, like everyone else");
      //terriblechoice=1;
      cLady.Say("Who understood that strength... is a matter of perspective.");
       
       
       
        //cLady.Say("The blade is only as dangerous as we perceive it to be.");
       //cLady.Say("Because being able to embrace other's perspectives is how we have always survived...");
        
       
     }
     else {
     
  
    cLady.Say("There once was a blacksmith plying his trade");
    //cLady.Say("Built for a time of war, long past");
   // cLady.Say("Who served in a time of war.");
    if (Fullcircle==0) {
    Wait(50);
    }
    cLady.Say("Weapons are all he knows and will discuss.");
   
   // cLady.Say("Weapons are all he knows and will discuss");
   // cLady.Say("Weapons are all he has left");
   
    
    
    cLady.Say("But some secrets of fire are known to him besides");
    
       cLady.Say("And he might hold... the last embers left on this earth");

     if (Fullcircle==0) {
    Wait(50);
    
    Wait(50);
     }
    cLady.Say("I remember... an image emblazoned onto a sign before the workshop");
    cLady.Say("A sword set in stone. Stuck fast, with no hope of escape...");
  
     if (findsword==0) {
       aMagic_chimes.Play();
  findsword=1;
  ObjectivesList.InsertItemAt(0,"Find the sword set in stone");
  addobjectivetimer=1;
      
      }
  
    ForgeMentioned=1;

     }

    Guessed=3;

    }
  
    
    else if ((Guessed==3)&&(prophecy==1)) {
      
      if (Descended==1) {
        
        cLady.Say("There is another who dwells under the city");
        cLady.Say("Who has been alone in the dark for so long...");
         
        Wait(50);
         
       cLady.Say("Light a candle and bring it down, perhaps it will help him remember... a time when there was light in his life");
       
          if (lightacandle==0) {
       aMagic_chimes.Play();
  lightacandle=1;
  ObjectivesList.InsertItemAt(0,"Take candle down into the dark");
  
  addobjectivetimer=1;
      Wait(80);
      }
       
        
       Wait(20);
        
       cLady.Say("Listen carefully to everything that must be said.");
        
       Wait(50);
        
         cLady.Say("I hope that will be enough...");
          cLady.Say("If not...");
         
          Wait(50);
           
          cLady.Say("I will think of something");
      
     
      }
      else {
      
      cLady.Say("There was another who dwelled under the city");
      cLady.Say("Our distributary...");
      cLady.Say("Who guarded a great underground reservoir");
      cLady.Say("Almost as closely as his solitude, that this sacred task would remain undisturbed");
      cLady.Say("And the waters that give us life... unpolluted");
       if (Fullcircle==0) {
     Wait(50);
     Wait(50);
       }
     
     cLady.Say("As far as I remember, there is only one way down");
    
      cLady.Say("In the east streets, a hole runs deep, down into the earth.");
      
      
      if (findawaydown==0) {
       aMagic_chimes.Play();
  findawaydown=1;
   ObjectivesList.InsertItemAt(0,"Find the reservoir");
  
  addobjectivetimer=1;
      }

      }  
      
       
       Guessed=4;                                             //temporary to skip the bringing light line
    }
    
      

    
    else if ((Guessed==4)&&(prophecy==1)) {
      cLady.Say("Oh... the third?");
       if (Fullcircle==0) {
      Wait(50);
       }
      cLady.Say("The third is a young lady");
      cLady.Say("Or at least... she was the last time we met");
       if (Fullcircle==0) {
      Wait(50);
       }
      cLady.Say("She lives in the country outside the city");
      cLady.Say("In a hermitage, with a fine garden she keeps well watered");
       if (Fullcircle==0) {
      Wait(50);
       }
      cLady.Say("She is a lover of all growing things...");
       if (Fullcircle==0) {
      Wait(50);
      Wait(50);
       }
      cLady.Say("I hope she is okay... it has been many years, and the world is not what it once was");
      
    
      
    Guessed=1;
    Fullcircle=1;
  
  }
  
  
  
  else if ((RestartReminder2==0)&&(Awoken==1)) {

  cLady.Say("Reveal yourself.");
  //cLady.Say("Speak up. I can't hear you");
  
  }


  else if ((Countenance==0) && (LEndCounter==0) &&(prophecy==0)) {
  cLady.Say("How rude of me");
  cLady.Say("I appear to have forgotten myself");
  cLady.Say("They call me the Lady.");
  Wait(50);
  cLady.Say("There was a time when I told fortunes for those who live in the town below");
  if (OR_TCounter[2]==0) {
  cLady.Say("May I ask... how have you found me, child?");
  cLady.Say("I thought this grove unreachable");
  }
  //cLady.Say("But the fates have blessed us with life, when so few remain");
  Countenance=1;
 

}






  else if (LEndCounter==0) {
  
  
  cLady.Say("I grow tired...");
  
  
  if ((OR_HBCounter[2]!=0)&&(TapCounter2==0)&&(Descended==1)) {
  cLady.Say("If you are satisfied. I think it is time");
  Wait(50);
  cLady.Say("Take the candle down into the dark, child");
  
      if (lightacandle==0) {
       aMagic_chimes.Play();
  lightacandle=1;
  ObjectivesList.InsertItemAt(0,"Take candle down into the dark");
  addobjectivetimer=1;
      Wait(80);
      }
      
  cLady.Say("Speak to the sunken one.");
  cLady.Say("Show him the gift of patience");
  

  
}
  
else {
  Wait(50);
  cLady.Say("Show me what you may, children");
  cLady.Say("Before I fall asleep again");
  
}





}

}
}


