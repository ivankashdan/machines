function cover() {
    if (coveryou==0) {
    lblAction.Text="";
    //Wait(10);
    Wait(30);
    cRogerEmpty.Say("Here, let me cover you from the wind");
    cRoger.Say("Now then... what's that you've got there?");
    Wait(100);
    
   
   coveryou=1;
  }
  
}


function Fallenonfallen() {
  
  if (cMap.ActiveInventory==iDiamond) {
    cMap.ActiveInventory=null;
   cMap.LoseInventory(iDiamond);
    ofD.ChangeRoom(cMap.Room);
    aDfalls.Play();
  }
  
  else if (cMap.ActiveInventory==iHeliobrother) {
    cMap.ActiveInventory=null;
   cMap.LoseInventory(iHeliobrother);
    ofHB.ChangeRoom(cMap.Room);
    aHBfalls.Play();
  }
    
  else if (cMap.ActiveInventory==iPearl) {
    cMap.ActiveInventory=null;
   cMap.LoseInventory(iPearl);
    ofPN.ChangeRoom(cMap.Room);
    aPfalls.Play();
  }
    
  else if (cMap.ActiveInventory==iLG) {
    cMap.ActiveInventory=null;
   cMap.LoseInventory(iLG);
    ofLG.ChangeRoom(cMap.Room);
    aLGfalls.Play();
  }
    
  else if (cMap.ActiveInventory==iPP) {
    cMap.ActiveInventory=null;
   cMap.LoseInventory(iPP);
    ofPP.ChangeRoom(cMap.Room);
   
  }
    
  else if (cMap.ActiveInventory==iZalron) {
    cMap.ActiveInventory=null;
   cMap.LoseInventory(iZalron);
    ofZ.ChangeRoom(cMap.Room);
    aZfalls.Play();
  }
    
  else if (cMap.ActiveInventory==iPR) {
    cMap.ActiveInventory=null;
   cMap.LoseInventory(iPR);
    ofPR.ChangeRoom(cMap.Room);
    aPRfalls.Play();
  }
    
  else if (cMap.ActiveInventory==iSpiraly) {
    cMap.ActiveInventory=null;
   cMap.LoseInventory(iSpiraly);
    ofS.ChangeRoom(cMap.Room);
    aSfalls.Play();
  }
    
  else if (cMap.ActiveInventory==iOR) {
    cMap.ActiveInventory=null;
   cMap.LoseInventory(iOR);
    ofOR.ChangeRoom(cMap.Room);
    aORfalls.Play();
  }
    
  else if (cMap.ActiveInventory==iT) {
    cMap.ActiveInventory=null;
   cMap.LoseInventory(iT);
    ofT.ChangeRoom(cMap.Room);
    aTfalls.Play();
  }
  
  
  
  
  
}


function HBpicnic() {
  
  if (Tfound==0) {
  
  aFireburning.Play();
  
  int HBblaze=Random(2);
  
  if (HBblaze==0) {
     cLastWords.SayBackground("Quick! Put it out");
  }
  else if (HBblaze==1) {
  cLastWords.SayBackground("The fire is spreading!");
  }
  
  else if (HBblaze==2) {
  cLastWords.SayBackground("The fire will consume us all!");
  }
  
  
  }
  
  
}

function HBwhirli() {
  
  
  if (WorldTreeDead==0) {
  
    aFireburning.Play();
  
  int HBblaze=Random(5);
  
  if (HBblaze==0) {
     cRoger.SayBackground("What could I have done...");
  }
  else if (HBblaze==1) {
  cRoger.SayBackground("There was nothing I could do...");
  }
  
  else if (HBblaze==2) {
  cRoger.SayBackground("The animals... the trees...");
  }
  
  else if (HBblaze==3) {
  cRoger.SayBackground("They're all gone...");
  }
  
  else if (HBblaze==4) {
  cRoger.SayBackground("All gone...");
  }
  
  else if (HBblaze==5) {
  cRoger.SayBackground("It burns...");
  }
  
  }
  
}



function BottleGuardian() {
  
  //OR_S_HBCounter[5]=1;
  //OR_SCounter[5]=4; //temporary!!!!
  
  
  if (Water==1) {
    
    if (newleaf==0) {
      Wait(10);
     GuardianMoves=1;
    cGuardianSpeech.Say("No thanks!");
  GuardianMoves=0;
  Wait(10);
    
    cGuardianSpeech.Say("I'm turning over a new leaf");
    Wait(30);
      GuardianMoves=1;
    cGuardianSpeech.Say("My body is a temple!");
       GuardianMoves=0;
    
    newleaf=1;
    }
    else if (newleaf==1) {
      
      cGuardianSpeech.SayBackground("My body is a temple!");
      
      
    }
    
    
    return;
  }
  
  
  DrinkCounter++;
  
  

  
  
if (wokenup==1) {
  onedrinktomany=1;
  
  
  
  
}


  if (fPNCounter==1) {
    
    reboot();
  }

    else if (OR_SCounter[5]==0) {
      GuardianMoves=1;
      cGuardianSpeech.Say("Ah! LICKEER");
      
      
      GuardianMoves=0;
   Wait(50);
  
      cGuardianSpeech.Say("Give it ere will ye");
       oOR_Sl.ChangeRoom(11);
Wait(50);
Wait(50);
   oOR_Sl.ChangeRoom(5);
   GuardianMoves=1;
   //aDay1_lady_loop5.Play();
      cGuardianSpeech.Say("Much better");
      cGuardianSpeech.Say("*Hic*");
      GuardianMoves=0;
      Wait(50);
      cGuardianSpeech.Say("*Ahem*");
       if (beggingstopped==0) {
       
      cGuardianSpeech.Say("I ain't got nuthin to [give ye in return, kid");
      cGuardianSpeech.Say("Nuthin' but memories, patchy at best...");
   
       }
       else {
         
  Wait(50);
      cGuardianSpeech.Say("So the party stopped [since the old well dried up");
   Wait(50);
      cGuardianSpeech.Say("No more liquids, [everyone sobers up!");
      cGuardianSpeech.Say("Sits still, nice and polite-like...");
      GuardianMoves=1;
     
      cGuardianSpeech.Say("What a sorry state of affairs!");
       GuardianMoves=0;
      
       Wait(50);
      cGuardianSpeech.Say("That's what those lot [are doing next door");
      cGuardianSpeech.Say("He-heh");
      cGuardianSpeech.Say("They're hungover as hell...");
       
      Wait(50);
   
    cGuardianSpeech.Say("Yes-siry this is precious liquid");

       }
     Rambling=0;
      Drinkready=1;
      DrinkPresented=1;
      
      if (findsomethingtodrink==1) {
          int i = 0;
 while (i < ObjectivesList.ItemCount) // search from first to last item
 {
    if (ObjectivesList.Items[i] == "Find something to drink")
    {
       // found it!
       ObjectivesList.RemoveItem(i); // remove this item
