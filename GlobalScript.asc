        cTap.Say("There's nothing more to see here...");
        

        
        OR_HB_PNCounter[25]=2;
      }
         
      
      
    }
    
    
    if((cMap.Room==5)&&(GEndCounter==0)) {
      if (OR_HB_PNCounter[5]==0) {
        
        GuardianMoves=1;
        cGuardianSpeech.Say("It's too hot! You tryna kill me, kid?");
        
       GuardianMoves=0;
        //cGuardianSpeech.Say("God damn pyromaniac");
        //cGuardianSpeech.Say("You go play with fire somewhere else, nutcase");
        
        OR_HB_PNCounter[5]=1;
      }
      
      
    }
    
    
    

}
  else {CollapseCounter=1;}
}



