Wait(50);
cLady.Say("You will sink deep into the unknown depths, from which the first roots sprung");
Wait(50);
cLady.Say("You will learn from those old souls");
cLady.Say("To teach the young");
cLady.Say("When spring comes again");
//cLady.Say("Go forth and find the others");
//cLady.Say("Go forth and find the others");
//cLady.Say("Unhook the weights from their ankles");
//cLady.Say("Listen to their songs of mourning");
//cLady.Say("Until is it finished");
//cLady.Say("So that the waters may run clear again");
//cLady.Say("And the concrete give way to new growth");
//cLady.Say("And life may grow in the dead land");
Fortune=0;
Wait(50);
Wait(50);
//cLady.Say("If you would know where to find them, speak to me again");
Wait(50);
cLady.Say("Child...");
Wait(50);
cLady.Say("I bid you to be patient");
Wait(50);
//cLady.Say("The seasons will turn");
//cLady.Say("And time is shorter than it seems");
cLady.Say("Will you not listen to the songs of the changed ones?");
cLady.Say("Though they are long and slow");
cLady.Say("Every song ends, eventually");
//Wait(50);
//cLady.Say("And a gift indeed it is to be present when the time comes");
//at the end");
