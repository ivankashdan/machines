function reboot() {
  
  
     Wait(50);
       cGuardianSpeech.Say("Ah! LICKEER");
      oOR_Sl.ChangeRoom(11);
      
      Wait(10);
      
      Game.StopAudio(eAudioTypeMusic);
      
   Wait(50);
   oOR_Sl.ChangeRoom(5);
   
      Wait(80);
      
      
  


       cGuardian.SetIdleView(27, 0);
       
       cGuardianSpeech.Say("OHHHHHH MY!");
       
        Speech.DisplayPostTimeMs=0;
        
        
         Speech.SkipStyle=eSkipTime;
    
   
           if (cityambience.PlayingClip == aWind_ghosttown_ambient) {
       
       while (cityambience.Volume!=20) {
  
  
  
  
       cityambience.Volume--;
       Wait(2);
        }
        
       }
       else if (cityambience.PlayingClip == aHK_ambient) {
       
       while (cityambience.Volume!=5) {
  
  
  
  
       cityambience.Volume--;
       Wait(5);
        }
       }
       
        
       aUnderground_collapse.Play();
       
      
     
       //aSilence.Play(eAudioPriorityNormal, eRepeat);
       
       cGuardian.SetIdleView(126, 0);
       cGuardianSpeech.Say("*rebooting system*");
       cGuardianSpeech.Say("*blockage discovered*");
       cGuardian.SetIdleView(27, 0);
       cGuardianSpeech.Say("*processing...*");
       GuardianMoves=1;
       cGuardianSpeech.Say("Ohhhhh");
       cGuardianSpeech.Say("Aaaaaah");
       GuardianMoves=0;
       Wait(50);
       cGuardian.SetIdleView(127, 0);
       cGuardianSpeech.Say("N][;f[se’f]se’f");
        //aCollapse1.Play();
    
       
       
       ofOR.ChangeRoom(5);
       aORfalls.Play();
       ofPN.ChangeRoom(5);
       aPfalls.Play();
       ofS.ChangeRoom(5);
       aSfalls.Play();
       oOR_Sl.ChangeRoom(11);
      
      
        //aTest_pearl_cure.Play();
       // aSilence.PlayQueued();
       
       
    
       
       
       
       ShakeScreen(5);
        
        
       

       cGuardian.SetIdleView(27, 0);
       //Wait(20);
       CollapsedRoom=1;
       Collapsed=1;
       //ShakeScreen(0);
       
       
       Speech.SkipStyle=eSkipMouseTime;
       
       
           if (cityambience.PlayingClip == aWind_ghosttown_ambient) {
       
       while (cityambience.Volume!=50) {
  
  
  
  
       cityambience.Volume++;
       Wait(2);
        }
        
       }
       else if (cityambience.PlayingClip == aHK_ambient) {
       
       while (cityambience.Volume!=10) {
  
  
  
  
       cityambience.Volume++;
       Wait(5);
        }
       }
       
       
         aGuardianRhythm2.Play(eAudioPriorityNormal, eOnce);
       cGuardianSpeech.Say("BAM!");
       //Wait(50);
       cGuardianSpeech.Say("And we're back in business");
       Wait(50);
       cGuardianSpeech.Say("Not quite sure what you did there Chuck, but...");
       GuardianMoves=1;
       cGuardianSpeech.Say("I feel like a million bucks");
       GuardianMoves=0;
       Wait(20);
       Wait(50);
        Speech.DisplayPostTimeMs=1000;
       cGuardianSpeech.Say("Like something important just happened");
       Wait(50);
       cGuardianSpeech.Say("Like I've... done a good job");
        Wait(20);
     //  Wait(120);
       GuardianMoves=1;
       cGuardianSpeech.Say("Oh man... the old man would be proud");
       GuardianMoves=0;
       Wait(50);
       cGuardianSpeech.Say("Hmm...");
       cGuardianSpeech.Say("I really ought to check up on him down there one of these days");
       
       
       
  //where fades adjustment was before
      
       
       //aSilence.Stop();
       Water=1;
       if (takepearl==1) {
          int i = 0;
 while (i < ObjectivesList.ItemCount) // search from first to last item
 {
    if (ObjectivesList.Items[i] == "Give pearl away")
    {
       // found it!
       ObjectivesList.RemoveItem(i); // remove this item
       i = ObjectivesList.ItemCount; // a trick to end the loop right away
    }
    i++; // next item...
}
      CompletedList.InsertItemAt(0,"Give pearl away");
   }

       
       
       
       
       
    

       //aMeadow_var2.Stop();
       //aGuardian.Stop();
       Rambling=200;
       
       wokenup=0;
       
       
       
       OR_Sl_PNCounter[5]=1;
  
  
}





