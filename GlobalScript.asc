function cTap_Interact()
{


IdleHeld=1;
  IdleTimer=0;

  
  if (Water==1) {
    if (watersarerunningagain==0) {
   
    cTap.Say("Ohhh that's wet my whistle!");
    cTap.Say("I can see clearly now");
    cTap.Say("The water is clear");
    cTap.Say("Ohhh I can feel it running through me");
    cTap.Say("What a wonderful day to be useful");
    watersarerunningagain=1;
  }
   else if (watersarerunningagain==1) {
   
    cTap.Say("The waters are running again");
    Wait(50);
    GameOver=1;
    cMap.ChangeRoom(30);
    
  }
  }
  
  
  else if ((TapLight==0)&&(TapCounter2!=0)&&(candleseen!=0))  {
    
    cTap.Say("You'll get nothing else from me, worm...");
    
  }
  
  
  else if ((TapLight==0)&&(TapCounter2==0)) {
  
  
  if (candleseen==1) {
    
    cTap.Say("Where did you go?");
    
    candleseen=2;
    
  }
  
  else if (candleseen==2) {
    
    cTap.Say("Was I imagining things or were you here just now?");
    candleseen=3;
  }
  
    else if (candleseen==3) {
    
    cTap.Say("Raise the light again and talk to me, worm");
    
    
    //candleseen=3;
  }
  
 
  
  else if (TapCounter==0) {

cTap.Say("Some kind of rat");
cTap.Say("Slithered down the wrong pipe, I should think");
//cTap.Say("Come down the wrong pipe, I should think");
//cTap.Say("Nothing here for you damn rodent");
//cTap.Say("This well is mine!");
TapCounter=1;
  }
 else if (TapCounter==1) {
cTap.Say("There's nothing left for you, sink-scum!");
TapCounter=2;
  }

else if (TapCounter==2) {
cTap.Say("Dancing shadow thinks it can steal from my reserves");
cTap.Say("Well I'm not going anywhere");
//Wait(2);
cTap.Say("This here is my bill...");
cTap.Say("For years of reliable, unfaltering service");
TapCounter=3;
  }
  else if (TapCounter==3) {
cTap.Say("The well is mine!");


TapCounter=1;
  }
  }
  
 
  
  else if ((TapLight==1)&&(object[0].Visible==false)) {
     
    
       if (TapCounter2==0) {
     
     cTap.Say("Hehe, you've come to help me have you?");
     cTap.Say("After all this time?");

     cTap.Say("Is that what you've been doing up there, dancing on the surface?");

     cTap.Say("Helping people?");
     Wait(2);
       Game.StopAudio(eAudioTypeAmbientSound);
       Game.StopAudio(eAudioTypeMusic);
     cTap.Say("Killing them I'd say. Killing them dead");
     Wait(50);
     Wait(50);
     Wait(50);
     cTap.Say("Rooting out the sole survivors");

     cTap.Say("Salting the earth");

   Wait(50);
  
   //aTerrain_loop3.Play(eAudioPriorityNormal, eOnce);
     cTap.Say("Oh... I've been paying close attention to your wanderings");
     cTap.Say("I've been listening through the pipes");

     cTap.Say("Well it won't work on me");
     Wait(50);
     Wait(2);
     cTap.Say("I've lived enough lifetimes to know how 'the children' work");
     cTap.Say("Oh, innocent agents of entropy...");
     cTap.Say("You're a damn reaper, kid!");
     Wait(2);
     cTap.Say("Come to peck at a corpse!");
     

    
     cTap.Say("*cough cough*");
     Wait(50);

   
     Wait(50);
     cTap.Say("Well I won't entertain you");
     Wait(50);
     cTap.Say("Go feast on someone else's misery");
     //Wait(2);
     //cTap.Say("Maybe your... beloved Lady of the woods");
     //cTap.Say("Hehe");
  
     Wait(50);
     //aMagnolia_loop5.Play(eAudioPriorityNormal, eOnce);
     aUnderground_ambient.Play();
     Ramblingdark=0;
     
     TapCounter2=1;
     
   }
   
    else if (TapCounter2==1) {
      

      cTap.Say("You know what you are...");
      cTap.Say("A disease...");

     cTap.Say("I'd flush you out, if I could!");
     
     Wait(50);
     cTap.Say("You've come to uproot a stubborn old weed");
      
  
      cTap.Say("Let's not pretend you're here for anything else");
      Wait(50);

      cTap.Say("Anyway what good would it do?");
      cTap.Say("Nothing new will grow");

      cTap.Say("Without water we are lost");
      
 
      
        TapCounter2=2;
    }
    
     else if (TapCounter2==2) {
      
      cTap.Say("No, I don't know where it's gone");
      cTap.Say("Water is water.");
     // Wait(2);
      cTap.Say("Water runs where water runs");
        cTap.Say("I send it on to those who need it, when I have enough for myself");
       // Wait(2);
      cTap.Say("Now, I do not. I have an empty basin");
      Wait(2);
      cTap.Say("The only moisture is trapped in stains");
      cTap.Say("That I will never, ever be able to wash away");
        TapCounter2=3;
    }
    
         else if (TapCounter2==3) {
      
      cTap.Say("I can hear them, you know?");
      cTap.Say("Gathering around up top");
      //Wait(2);
      cTap.Say("They don't know why they're doing it, they're just...");
      cTap.Say("Being drawn to the source. Like dowsing rods");
          Wait(50);
          Wait(2);
      cTap.Say("They don't know I'm still down here");
      cTap.Say("Nothing they could do, even if they knew");
      //Wait(2);
      cTap.Say("Nothing anyone can do; it's all gone.");
      //Wait(2);
      cTap.Say("Dry as a bone");
      Wait(2);
      cTap.Say("Cold as the night");
      //cTap.Say("The pipes are silent");

        TapCounter2=4;
    }
    
    
       else if (TapCounter2==4) {
      
      cTap.Say("You're still here, are you?");
      cTap.Say("Even after what I called you...");
      
      Wait(50);
      Wait(2);
        cTap.Say("You're a persistent one, I'll give you that");
        //Wait(2);
        Wait(50);
        cTap.Say("But nothing else");
        
      //cTap.Say("But I must say, it's good to have an audience again");
      //cTap.Say("The other one stopped listening a while ago...");
        TapCounter2=5;
    }
    
    
    
    
    

    
    else if (TapCounter2==5) {
     
     cTap.Say("Nothing else...");
     
 

        TapCounter2=5;
    }
    
       else if (TapCounter2==6) {
      cTap.Say("We're nothing alike");
      

      

        TapCounter2=6;
    }
    
        else if (TapCounter2==7) {
      cTap.Say("This cave... is mine to keep");
      

        TapCounter2=7;
    }
      
  }
  
  else if (object[0].Visible==true) {
    
    cTap.Say("Some kind of... radioactive rat?");
  }
  
  
}

