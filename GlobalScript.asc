function unhandled_event (int what, int type) 
{
  if (what == 1) // Unhandled events for HOTSPOTS
  {
    if (type == 1) // look
    {
      
    }
    else if (type == 2) // interact
    {
      
    }
    else if (type == 3) // use inv on
    {
      
      //cMap.ActiveInventory=null;
        
    }
  }
  else if (what == 2) // Unhandled events for OBJECTS
  {
    if (type == 0) // look
    {
      
    }
    else if (type == 1) // interact
    {
      //opportunity here to say if it isn't an Elder (find a way to mark this), trigger a collapse.
      
      
      
      if((Object.GetAtScreenXY(mouse.x, mouse.y)==object[14]) || //PR click 
      (Object.GetAtScreenXY(mouse.x, mouse.y)==object[23])  || //PPS click  
      (Object.GetAtScreenXY(mouse.x, mouse.y)==object[2])) //Place click 
      { 
      }
      else {
        CollapseCounter=1;
        }
      
      
  
      
      
      
      }
    else if (type == 3) // use inv on
    {
      //cMap.ActiveInventory=null;
      //CollapseCounter=1;
      //opportunity here to say if it isn't an Elder (find a way to mark this), trigger a collapse.
      
    }
  }
  
  
  else if (what == 3) // Unhandled events for CHARACTERS
  {
    if (type == 0) // look
    {
      
    }
    else if (type == 1) // interact
    {
      
      CollapseCounter=1;
      
      
     //opportunity here to say if it isn't an Elder (find a way to mark this), trigger a collapse.
    }
    else if (type == 3) // use inv on
    {
      
      
      
       //cMap.ActiveInventory=null;
      CollapseCounter=1;
      
      
      //opportunity here to say if it isn't an Elder (find a way to mark this), trigger a collapse.
    }
  }
  
  
  
  else if (what == 5) // Unhandled events for INVENTORY ITEMS
  {
    if (type == 0) // look
    {
      
    }
    else if (type == 1) // interact
    {
      
    }
    else if (type == 3) // use inv on
